---
import type { CollectionEntry } from "astro:content";
import { entrySlug } from "../lib/content";
interface Props {
  project: CollectionEntry<"projects">;
  index: number;
}
const { project, index } = Astro.props;
const slug = entrySlug(project);
---

<article class="work-row">
  <div class="work-info">
    <span class="meta">
      {String(index + 1).padStart(2, "0")} / {project.data.type}
    </span>
    <h3>
      <a href={`/projects/${slug}/`}>{project.data.title}</a>
    </h3>
    <p>{project.data.excerpt}</p>
    {project.data.outcome && <p class="work-outcome">{project.data.outcome}</p>}
    <div class="work-stack">
      {project.data.stack.map((item) => (
        <span>{item}</span>
      ))}
    </div>
    <a class="text-link" href={`/projects/${slug}/`}>
      Inside the project <span aria-hidden="true">↗</span>
    </a>
  </div>
  {slug === "cloudtrail-quickscan" ? (
    <div
      class="specimen"
      aria-label="CloudTrail scanner example findings from synthetic data"
    >
      <span class="kicker">CloudTrail / synthetic sample</span>
      <pre><span class="signal">HIGH</span>  IAM permissions boundary removed<br /><span class="signal">HIGH</span>  CloudTrail logging change<br /><span class="signal">HIGH</span>  Public admin-port ingress: SSH<br /><br />Event → rule → finding → investigation</pre>
    </div>
  ) : slug === "studypulse" ? (
    <div
      class="specimen flow-specimen"
      aria-label="StudyPulse learning evidence pipeline"
    >
      <span class="kicker">StudyPulse / evidence pipeline</span>
      <div class="flow-step">
        <b>Study session</b>
        <span>record time</span>
      </div>
      <div class="flow-step">
        <b>Recall check</b>
        <span>grade evidence</span>
      </div>
      <div class="flow-step">
        <b>Verified result</b>
        <span>compute reward</span>
      </div>
      <div class="flow-step">
        <b>Review schedule</b>
        <span>estimate recall</span>
      </div>
    </div>
  ) : (
    <div
      class="specimen"
      aria-label="JSONL inspection example from the repository sample"
    >
      <span class="kicker">jsonl-lens / sample inspection</span>
      <pre>Field gaps<br />  request_id:  missing=1, null=0<br />  duration_ms: missing=2, null=0<br /><br />Nested fields<br />  http.method: 2<br />  http.status: 2</pre>
    </div>
  )}
</article>
