---
import { execSync } from "node:child_process";
// The commit this page was built from, linked so anyone can read the source.
const commit = (() => {
  try {
    return (process.env.GITHUB_SHA ?? execSync("git rev-parse HEAD", { encoding: "utf8" })).trim();
  } catch {
    return "";
  }
})();
const builtOn = new Date().toISOString().slice(0, 10);
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-meta">
      <p>© 2026 Haitao Zheng</p>
      {commit && (
        <p class="build">
          Built {builtOn} from{" "}
          <a href={`https://github.com/0xTaoZ/tzheng.dev/commit/${commit}`}>{commit.slice(0, 7)}</a>
        </p>
      )}
    </div>
    <nav aria-label="Footer">
      <a href="mailto:h@tzheng.dev">Email</a>
      <a href="https://github.com/0xTaoZ">GitHub</a>
      <a href="https://www.linkedin.com/in/haitaozheng/">LinkedIn</a>
      <a href="/about/">About</a>
      <a href="/resume/">Résumé</a>
      <a href="/topics/">Topics</a>
      <a href="/system/">About this site</a>
      <a href="/legal/#impressum">Impressum</a>
      <a href="/legal/#datenschutz">Datenschutz</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line, rgba(255,255,255,.08)); padding: 2rem 0 2.5rem; color: var(--text-2, #aab3c0); }
  .footer-inner {
    max-width: calc(var(--container, 1120px) + 2 * var(--gutter, 2rem));
    margin: 0 auto;
    padding: 0 var(--gutter, 2rem);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
  }
  p { margin: 0; font-size: .85rem; }
  .build { margin-top: .3rem; font: .72rem var(--font-mono, ui-monospace, monospace); color: var(--text-3, #808b9b); }
  nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .6rem 1.3rem; }
  a { color: inherit; font-size: .85rem; text-decoration: none; }
  .build a { font-size: inherit; }
  a:hover { color: #fff; text-decoration: underline; text-underline-offset: .25rem; }
  @media (max-width: 760px) {
    .footer-inner { flex-direction: column; }
    nav { justify-content: flex-start; }
  }
</style>
