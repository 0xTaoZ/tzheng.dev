---
import "../styles/board.css";
interface Props {
  // The homepage hero already shows these totals.
  showTotals?: boolean;
}
const { showTotals = true } = Astro.props;
import {
  combinedStars,
  compactNumber,
  mergedCount,
  monthlyMerged,
  openCount,
  repositoryCount,
  upstreamRepositories,
  verifiedAt,
} from "../lib/contributions";
const peak = Math.max(...monthlyMerged.map((month) => month.count));
const verifiedLabel = new Date(`${verifiedAt}T00:00:00Z`).toLocaleDateString(
  "en",
  { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" },
);
---

    {showTotals && (
    <dl class="stat-row reveal" aria-label="Contribution summary">
      <div><dt>Merged upstream PRs</dt><dd data-roll>{mergedCount}</dd></div>
      <div><dt>Upstream repositories</dt><dd data-roll>{repositoryCount}</dd></div>
      <div><dt>Combined GitHub stars</dt><dd data-roll>{compactNumber(combinedStars)}</dd></div>
      <div><dt>Open PRs in review</dt><dd data-roll>{openCount}</dd></div>
    </dl>
    )}

    <div class="upstream-board reveal">
      <div class="panel upstream-list">
        <p class="panel-label" style="padding-inline: .7rem"><span>Merged into</span><span class="repo-columns"><span>PRs</span><span>Stars</span></span></p>
        <ol>
          {upstreamRepositories.map((repository) => (
            <li>
              <a href={repository.url}>
                <span class="repo-name"><span class="repo-owner">{repository.owner}/</span>{repository.repo}</span>
                <span class="repo-count">{repository.merged}</span>
                <span class="repo-stars">{compactNumber(repository.stars)}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <figure class="panel merge-chart">
        <p class="panel-label">
          <span>Merged per month</span>
          <span>{monthlyMerged[0].label}–{monthlyMerged.at(-1)!.label} {verifiedAt.slice(0, 4)}</span>
        </p>
        <div class="merge-bars">
          {monthlyMerged.map((month) => (
            <div class:list={["merge-bar", month.partial && "partial"]}>
              <span class="merge-value">{month.count}</span>
              <span class="merge-fill" style={`--height:${Math.max(4, (month.count / peak) * 100)}%`}></span>
              <span class="merge-month">{month.label}{month.partial && <small>to date</small>}</span>
            </div>
          ))}
        </div>
        <figcaption>
          Snapshot verified {verifiedLabel}: merged pull requests by 0xTaoZ
          outside personal repositories; stars as of the same date.
        </figcaption>
      </figure>
    </div>

