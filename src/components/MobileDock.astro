---
import "../styles/mobile.css";
import LangSwitch from "./LangSwitch.astro";
interface Props {
  // On the homepage section links stay on the page; elsewhere they go back to it.
  home?: boolean;
}
const { home = false } = Astro.props;
const prefix = home ? "" : "/";
const sections = [
  { href: `${prefix}#contributions`, label: "Open source" },
  { href: `${prefix}#projects`, label: "Projects" },
  { href: `${prefix}#notes`, label: "Writing" },
  { href: `${prefix}#education`, label: "Education" },
  { href: `${prefix}#toolkit`, label: "Toolkit" },
  { href: `${prefix}#contact`, label: "Contact" },
];
const pages = [
  { href: "/articles/", label: "All articles" },
  { href: "/projects/", label: "All projects" },
  { href: "/contributions/", label: "Merged PRs" },
  { href: "/about/", label: "About" },
];
---

<nav class="dock" aria-label="Quick actions" data-dock>
  <button type="button" data-sheet-open aria-haspopup="dialog">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    <span>Menu</span>
  </button>
  <button type="button" data-palette-open>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
    <span>Search</span>
  </button>
  <a href="/resume/">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6" /></svg>
    <span>Résumé</span>
  </a>
  <a class="dock-primary" href="mailto:h@tzheng.dev">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 7 8.5 6 8.5-6" /></svg>
    <span>Email</span>
  </a>
</nav>

<dialog class="sheet" data-sheet aria-label="Site menu">
  <div class="sheet-grip" data-sheet-grip>
    <span aria-hidden="true"></span>
    <p>Haitao Zheng</p>
    <LangSwitch />
    <button type="button" data-sheet-close>Close</button>
  </div>
  <div class="sheet-body" data-lenis-prevent>
    <ul class="sheet-group">
      {sections.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
    <ul class="sheet-group">
      {pages.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
    <ul class="sheet-group">
      <li><a href="https://github.com/0xTaoZ">GitHub</a></li>
      <li><a href="https://www.linkedin.com/in/haitaozheng/">LinkedIn</a></li>
    </ul>
  </div>
</dialog>

<script>
  import "../scripts/dock.ts";
</script>
