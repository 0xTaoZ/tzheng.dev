---
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import { existsSync } from "node:fs";
import { person } from "../lib/identity";
interface Props {
  title: string;
  description?: string;
  keywords?: string | string[];
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article" | "profile";
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description = "Haitao Zheng's projects, upstream contributions and technical notes.",
  ogImage: requestedImage,
  ogImageAlt = "Haitao Zheng, tzheng.dev",
  ogType = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  structuredData = [],
} = Astro.props;
// Per-page share cards are generated by scripts/build-og.mjs; fall back to the
// site card when a page has none yet.
const ogImage =
  requestedImage && existsSync(`public${requestedImage}`)
    ? requestedImage
    : "/og/default.png";
const canonical = new URL(
  Astro.url.pathname === "/404/" ? "/404.html" : Astro.url.pathname,
  Astro.site,
);
const imageUrl = new URL(ogImage, Astro.site).toString();
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    person,
    {
      "@type": "WebSite",
      "@id": "https://tzheng.dev/#website",
      name: "tzheng.dev",
      alternateName: ["Haitao Zheng", "郑海涛"],
      url: "https://tzheng.dev/",
      inLanguage: "en",
      publisher: { "@id": "https://tzheng.dev/#person" },
    },
    {
      "@type": "WebPage",
      "@id": canonical.toString(),
      url: canonical.toString(),
      name: title,
      description,
      inLanguage: "en",
      isPartOf: { "@id": "https://tzheng.dev/#website" },
      about: { "@id": "https://tzheng.dev/#person" },
      primaryImageOfPage: { "@type": "ImageObject", url: imageUrl },
    },
    ...(Array.isArray(structuredData) ? structuredData : [structuredData]),
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#07090c" />
<meta name="color-scheme" content="dark" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Haitao Zheng" />
<meta
  name="robots"
  content="index, follow, max-image-preview:large, max-snippet:-1"
/>
<meta name="referrer" content="strict-origin-when-cross-origin" />
<link rel="canonical" href={canonical} />
<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
<link rel="me" href="https://github.com/0xTaoZ" />
<link rel="me" href="https://www.linkedin.com/in/haitaozheng/" />
<link rel="icon" href="/favicon.png" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<meta property="og:site_name" content="tzheng.dev" />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
{ogType === "profile" && (
  <>
    <meta property="profile:first_name" content="Haitao" />
    <meta property="profile:last_name" content="Zheng" />
    <meta property="profile:username" content="0xTaoZ" />
  </>
)}
{publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{ogType === "article" && (
  <meta property="article:author" content="https://tzheng.dev/about/" />
)}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />
<link
  rel="alternate"
  type="application/rss+xml"
  title="Haitao Zheng: articles"
  href="/rss.xml"
/>
<script is:inline>
  // Tell the page-turn transition which way to turn on history navigation.
  addEventListener("pagereveal", (event) => {
    const activation = window.navigation && navigation.activation;
    if (!event.viewTransition || !activation) return;
    const back = activation.navigationType === "traverse" && activation.from && activation.entry && activation.entry.index < activation.from.index;
    event.viewTransition.types.add(back ? "back" : "forward");
  });
</script>
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(graph).replaceAll("<", "\\u003c")}
/>
