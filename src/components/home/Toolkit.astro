---
import { getCollection } from "astro:content";
import SectionHeader from "./SectionHeader.astro";
const articleCount = (
  await getCollection("articles", ({ data }) => data.status === "published")
).length;
// Each area names its tools and links to the work that shows them in use.
const areas = [
  {
    area: "Systems & infrastructure",
    tools: ["Linux", "SSH", "Networking"],
    text: "Linux, networking coursework and SSH connector fixes in pyinfra.",
    evidence: [
      { label: "pyinfra #1945", href: "https://github.com/pyinfra-dev/pyinfra/pull/1945" },
      { label: "socket-state-triage", href: "/projects/socket-state-triage/" },
      { label: "authlog-watch", href: "/projects/authlog-watch/" },
    ],
  },
  {
    area: "Cloud & security",
    tools: ["AWS CloudTrail", "CloudFormation", "Kubernetes", "ECS"],
    text: "AWS audit-log review, CloudFormation validation and Kubernetes security checks through local tools and upstream contributions.",
    evidence: [
      { label: "cloudtrail-quickscan", href: "/projects/cloudtrail-quickscan/" },
      { label: "cfn-lint #4704", href: "https://github.com/aws-cloudformation/cfn-lint/pull/4704" },
      { label: "Prowler #11837", href: "https://github.com/prowler-cloud/prowler/pull/11837" },
      { label: "Prowler #12217", href: "/articles/missing-evidence-is-not-a-pass/" },
    ],
  },
  {
    area: "Software supply chain",
    tools: ["Trivy", "GuardDog", "Licenses"],
    text: "License detection in Trivy's JAR parser and safer finding links in GuardDog's package scanner.",
    evidence: [
      { label: "Trivy #10939", href: "/articles/jar-license-sources/" },
      { label: "GuardDog #797", href: "/articles/terminal-links-are-output-too/" },
    ],
  },
  {
    area: "Development",
    tools: ["Python", "Java", "C", "TypeScript", "SQL"],
    text: "Python parsers, Java access-log review, C socket inspection and TypeScript application rules.",
    evidence: [
      { label: "jsonl-lens", href: "/projects/jsonl-lens/" },
      { label: "java-web-log-triage", href: "/projects/java-web-log-triage/" },
      { label: "StudyPulse", href: "/projects/studypulse/" },
    ],
  },
  {
    area: "Deployment",
    tools: ["GitHub Actions", "GitHub Pages", "Cloudflare Workers", "D1"],
    text: "GitHub Actions and GitHub Pages for this site; Worker APIs and SQL persistence in StudyPulse.",
    evidence: [
      { label: "System design", href: "/system/" },
      { label: "StudyPulse", href: "/projects/studypulse/" },
    ],
  },
  {
    area: "Technical writing",
    tools: ["Markdown", "Code review"],
    text: "Notes on specific fixes, test cases and implementation limits, linked to the code and review.",
    evidence: [
      { label: `${articleCount} articles`, href: "/articles/" },
      { label: "Contribution record", href: "/contributions/" },
    ],
  },
];
const principles = [
  ["Build small first", "Use focused tools, readable outputs, and testable behavior before adding complexity."],
  ["Write while learning", "Turn projects into notes so the reasoning is visible, not only the final repository."],
  ["Security mindset", "Check rejection paths alongside valid inputs, and state what the evidence does not establish."],
];
---

<section id="toolkit" class="section">
  <div class="container">
    <SectionHeader index="05" title="Toolkit">
      <p class="section-lede">Tools and languages used in the work above.</p>
    </SectionHeader>
    <div class="skill-table reveal" role="table" aria-label="Toolkit">
      <div class="skill-row skill-header" role="row">
        <span role="columnheader">Area</span>
        <span role="columnheader">Used for</span>
        <span role="columnheader">See</span>
      </div>
      {areas.map((row) => (
        <div class="skill-row" role="row">
          <div role="rowheader">
            <h3>{row.area}</h3>
            <ul class="stack-list">{row.tools.map((tool) => <li>{tool}</li>)}</ul>
          </div>
          <p role="cell">{row.text}</p>
          <ul class="evidence-list" role="cell">
            {row.evidence.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="principles reveal">
      <p class="list-label">How I work</p>
      <div class="principle-grid">
        {principles.map(([title, text]) => (
          <div><h3>{title}</h3><p>{text}</p></div>
        ))}
      </div>
    </div>
  </div>
</section>
