---
import SectionHeader from "./SectionHeader.astro";
const languages = [
  ["English", "C2 Professional"],
  ["German", "C1 Advanced Academic"],
  ["Mandarin", "Native"],
  ["Hokkien", "Fluent"],
  ["Japanese", "A2 Elementary"],
];
const interests = [
  ["Photography", "I shoot portraits, everyday street scenes and landscapes on a Nikon D750."],
  ["Athletics & fitness", "Football, skateboarding, basketball, badminton and volleyball, plus regular strength training."],
  ["Global insight & cycling", "Recreational off-road cycling. I also follow geopolitics, investing and global markets."],
];
---

<section id="about" class="section">
  <div class="container">
    <SectionHeader
      index="07"
      label="Beyond the code"
      title="Languages & interests"
      link={{ href: "/about/", label: "Full profile · 中文 · Deutsch" }}
    />
    <div class="about-grid">
      <div class="reveal">
        <p class="list-label">Languages</p>
        <dl class="language-list">
          {languages.map(([name, level]) => (
            <div><dt>{name}</dt><dd>{level}</dd></div>
          ))}
        </dl>
      </div>
      <div class="reveal delay-1">
        <p class="list-label">Personal interests</p>
        <dl class="interest-list">
          {interests.map(([title, text]) => (
            <div><dt>{title}</dt><dd>{text}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>
