---
const links = [
  { href: "#contributions", label: "Open source" },
  { href: "#projects", label: "Projects" },
  { href: "#education", label: "Education" },
  { href: "#notes", label: "Writing" },
  { href: "#toolkit", label: "Toolkit" },
  { href: "#contact", label: "Contact" },
];
---

<header class="site-nav" data-nav>
  <div class="nav-inner">
    <a class="wordmark" href="#top" aria-label="Haitao Zheng, back to top">
      <img src="/img/logo-64.webp" alt="" width="28" height="28" />
      <span>Haitao Zheng</span>
    </a>
    <nav class="nav-links" aria-label="Sections">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href="/articles/">Articles</a>
      <a href="/resume/">Résumé</a>
    </nav>
    <div class="nav-actions">
      <button class="kbd-button" type="button" data-palette-open aria-label="Search the site">
        <kbd>⌘</kbd><kbd>K</kbd>
      </button>
      <a class="nav-github" href="https://github.com/0xTaoZ" aria-label="GitHub profile 0xTaoZ">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12.02c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.56 9.56 0 0 1 12 6.84c.85 0 1.71.11 2.5.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.94.36.31.68.92.68 1.86v2.75c0 .27.18.58.69.48A10.02 10.02 0 0 0 22 12.02C22 6.48 17.52 2 12 2z" />
        </svg>
        <span>GitHub</span>
      </a>
      <button
        id="mobile-menu-button"
        class="menu-button"
        type="button"
        aria-label="Open navigation"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span></span><span></span>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="mobile-menu" aria-label="Sections" aria-hidden="true">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a href="/articles/">Articles</a>
    <a href="/resume/">Résumé</a>
    <a href="/about/">About</a>
    <a href="https://github.com/0xTaoZ">GitHub ↗</a>
  </nav>
