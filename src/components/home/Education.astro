---
import SectionHeader from "./SectionHeader.astro";
const schools = [
  {
    period: "Oct 2025 – present",
    logo: "/img/hbrs-logo.webp",
    institution: "Hochschule Bonn-Rhein-Sieg (H-BRS)",
    place: "Germany · University of Applied Sciences",
    program: "B.Sc. Cyber Security & Privacy",
    current: true,
    details: [
      ["Academic focus", "Java programming, Linux, networking protocols, SQL database systems, mathematics and Technische Informatik (digital and analog electronics)."],
      ["Privacy & security", "The General Data Protection Regulation (GDPR), privacy by design and infrastructure security under European regulation."],
      ["Coursework & projects", "Systems programming assignments and projects in Java, C, SQL, networking and Linux."],
    ],
  },
  {
    period: "Dec 2024 – Jun 2025",
    logo: "/img/fhm-logo.webp",
    institution: "FHM University of Applied Sciences",
    place: "Bielefeld, Germany",
    program: "University Preparation & FSP",
    details: [
      ["University preparation", "Completed the German university preparatory pathway and Feststellungsprüfung (FSP)."],
      ["Language achievement", "Certified German C1 within the same six months."],
    ],
  },
  {
    period: "2024",
    logo: "/img/harvard-logo.webp",
    institution: "Harvard CS50x",
    place: "Online course",
    program: "Computer Science Foundations",
    details: [
      ["Engineering foundations", "Completed CS50x coursework in algorithms, data structures, C, Python, SQL and web development."],
      ["Final project", "Completed an independent final programming project."],
    ],
  },
  {
    period: "Sep 2021 – Jun 2024",
    logo: "/img/jimei-logo.webp",
    institution: "Xiamen Jimei Middle School",
    place: "Xiamen, China",
    program: "High School Diploma",
    details: [
      ["Academic background", "Completed science-focused secondary education in Xiamen."],
      ["Academic transition", "Completed the Gaokao before continuing university preparation in Germany."],
    ],
  },
];
---

<section id="education" class="section">
  <div class="container">
    <SectionHeader index="04" title="Education" />
    <ol class="edu-timeline">
      {schools.map((school) => (
        <li class:list={["edu-item", "reveal", school.current && "current"]}>
          <div class="edu-when">
            <time>{school.period}</time>
          </div>
          <div class="edu-body">
            <div class="edu-head">
              <span class="edu-logo">
                <img src={school.logo} alt="" width="40" height="40" loading="lazy" decoding="async" />
              </span>
              <div>
                <h3>{school.institution}</h3>
                <p class="edu-place">{school.place}</p>
              </div>
            </div>
            <p class="edu-program">{school.program}</p>
            <dl class="edu-details">
              {school.details.map(([term, text]) => (
                <div><dt>{term}</dt><dd>{text}</dd></div>
              ))}
            </dl>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
