---
interface Props {
  title: string;
  link?: { href: string; label: string };
}
const { title, link } = Astro.props;
---

<header class="section-head reveal">
  <div class="section-title-row">
    <div>
      <h2>{title}</h2>
      <slot />
    </div>
    {link && (
      <a class="text-link" href={link.href}>
        {link.label}
      </a>
    )}
  </div>
</header>
