---
interface Props {
  index: string;
  label: string;
  title: string;
  link?: { href: string; label: string };
}
const { index, label, title, link } = Astro.props;
---

<header class="section-head reveal">
  <p class="section-index"><span>{index}</span>{label}</p>
  <div class="section-title-row">
    <div>
      <h2>{title}</h2>
      <slot />
    </div>
    {link && (
      <a class="text-link" href={link.href}>
        {link.label} <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</header>
