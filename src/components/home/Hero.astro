---
import { getCollection } from "astro:content";
import {
  combinedStars,
  compactNumber,
  mergedCount,
  mergedPRs,
  upstreamRepositories,
} from "../../lib/contributions";
import { disclosures } from "../../data/disclosures";
const [disclosure] = disclosures;
interface Props {
  terminalLines: string[];
}
const { terminalLines } = Astro.props;
const articleCount = (
  await getCollection("articles", ({ data }) => data.status === "published")
).length;
const cfnLintCount = mergedPRs.filter(
  (pr) => pr.repository === "aws-cloudformation/cfn-lint",
).length;
const byStars = [...upstreamRepositories].sort((a, b) => b.stars - a.stars);
const named = byStars.slice(0, 4).map((repository) => repository.label);
const projectList = `${named.slice(0, -1).join(", ")} and ${named.at(-1)}`;
---

<section class="hero" id="top">
  <div class="hero-backdrop" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      <h1 class="hero-title">
        <span class="word"><span>Haitao</span></span>
        <span class="word"><span>Zheng</span></span>
        <span class="hero-alias">(Tao)</span>
      </h1>
      <p class="hero-role">
        Blue team and cloud security, systems and infrastructure engineering
      </p>
      <p class="hero-lede">
        Cyber Security &amp; Privacy student at <span class="nowrap">H-BRS</span> in
        Bonn, Germany. I build small, explainable security tools and send fixes
        upstream to the projects I use, among them {projectList}. Red Hat Product Security credited me with discovering
        <a href="#disclosure" class="hero-cve">{disclosure.id}</a> in {disclosure.product}.
      </p>
      <dl class="hero-stats">
        <div><dt>merged PRs</dt><dd data-roll>{mergedCount}</dd></div>
        <div><dt>repositories</dt><dd data-roll>{upstreamRepositories.length}</dd></div>
        <div><dt>combined stars</dt><dd data-roll>{compactNumber(combinedStars)}</dd></div>
        <div><dt>articles</dt><dd data-roll>{articleCount}</dd></div>
      </dl>
      <div class="hero-actions">
        <a href="#contributions" class="btn btn-primary">View contributions</a>
        <a href="#projects" class="btn btn-ghost">View projects</a>
        <a href="/resume/" class="btn btn-ghost">Résumé</a>
        <span class="hero-icons">
          <a href="https://github.com/0xTaoZ" class="icon-link" aria-label="Haitao Zheng on GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12.02c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.56 9.56 0 0 1 12 6.84c.85 0 1.71.11 2.5.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.94.36.31.68.92.68 1.86v2.75c0 .27.18.58.69.48A10.02 10.02 0 0 0 22 12.02C22 6.48 17.52 2 12 2z" /></svg>
          </a>
          <a href="https://www.linkedin.com/in/haitaozheng/" class="icon-link" aria-label="Haitao Zheng on LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" /></svg>
          </a>
          <a href="mailto:h@tzheng.dev" data-email-contact class="icon-link" aria-label="Email Haitao Zheng">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </a>
        </span>
      </div>
    </div>

    <figure class="hero-portrait reveal delay-1">
      <picture>
        <source
          type="image/avif"
          srcset="/img/portrait-480.avif 480w, /img/portrait-720.avif 720w, /img/portrait-1122.avif 1122w"
          sizes="(max-width: 900px) 60vw, 420px"
        />
        <source
          type="image/webp"
          srcset="/img/portrait-480.webp 480w, /img/portrait-720.webp 720w, /img/portrait-1122.webp 1122w"
          sizes="(max-width: 900px) 60vw, 420px"
        />
        <img
          src="/img/portrait-720.jpg"
          alt="Haitao Zheng"
          width="1122"
          height="1402"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <figcaption class="profile-card">
        <p class="profile-summary">
          Security tooling, cloud logs, IOC workflows, and static-first web
          systems.
        </p>
        <dl>
          <div><dt>focus</dt><dd>blue-team / cloud-security / systems</dd></div>
          <div><dt>stack</dt><dd>Python / Java / C / SQL / TypeScript</dd></div>
          <div><dt>web</dt><dd>Astro / CSS / Markdown / GitHub / Cloudflare</dd></div>
        </dl>
      </figcaption>
    </figure>
  </div>

  <div class="container hero-lower">
    <div class="terminal reveal" aria-label="Terminal summary">
      <div class="terminal-bar">
        <span>tao@tzheng.dev: ~</span>
      </div>
      <pre class="terminal-output"><span id="terminal-output" data-lines={JSON.stringify(terminalLines)}>{terminalLines.join("\n")}</span><span class="terminal-cursor" aria-hidden="true"></span></pre>
    </div>
    <nav class="start-here reveal delay-1" aria-label="Quick links">
      <p class="list-label">Quick links</p>
      <a href="/projects/cloudtrail-quickscan/">
        <span class="start-kind">project / tool</span>
        <span class="start-title">cloudtrail-quickscan</span>
        <span class="start-meta">AWS logs and detection checks</span>
      </a>
      <a href="/projects/cfn-lint-contribution/">
        <span class="start-kind">open source / PR</span>
        <span class="start-title">cfn-lint contribution</span>
        <span class="start-meta">CloudFormation, {cfnLintCount} merged PRs</span>
      </a>
      <a href="/articles/">
        <span class="start-kind">writing / blog</span>
        <span class="start-title">Technical articles</span>
        <span class="start-meta">{articleCount} notes, archived by month</span>
      </a>
    </nav>
  </div>
</section>
