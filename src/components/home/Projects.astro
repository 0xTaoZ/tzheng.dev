---
import { getCollection } from "astro:content";
import SectionHeader from "./SectionHeader.astro";
import { entrySlug, selectHomepageProjects } from "../../lib/content";
const projects = selectHomepageProjects(await getCollection("projects"));
const [featured, ...rest] = projects;
---

<section id="projects" class="section">
  <div class="container">
    <SectionHeader
      index="02"
      label="Selected work"
      title="Projects"
      link={{ href: "/projects/", label: "All project cases" }}
    >
      <p class="section-lede">
        Small security tools I can explain line by line, a study product built
        for my own semester, and the engineering behind this site.
      </p>
    </SectionHeader>

    <article class="project-feature reveal">
      <div class="project-feature-copy">
        <p class="case-meta"><span>Featured build</span><span>{featured.data.type}</span></p>
        <h3><a href={`/projects/${entrySlug(featured)}/`}>{featured.data.title}</a></h3>
        <p class="project-excerpt">{featured.data.excerpt}</p>
        <ul class="stack-list" aria-label="Stack">
          {featured.data.stack.map((item) => <li>{item}</li>)}
        </ul>
        <div class="project-links">
          <a class="text-link" href={`/projects/${entrySlug(featured)}/`}>Read the case study <span aria-hidden="true">→</span></a>
          {featured.data.github && <a class="text-link muted" href={featured.data.github}>Source <span aria-hidden="true">↗</span></a>}
        </div>
      </div>
      <dl class="fact-grid">
        {featured.data.homepageFacts.map((fact) => (
          <div><dt>{fact.label}</dt><dd>{fact.text}</dd></div>
        ))}
      </dl>
    </article>

    <div class="project-grid">
      {rest.map((project) => (
        <article class="project-card reveal">
          <p class="case-meta"><span>{project.data.type}</span></p>
          <h3><a href={`/projects/${entrySlug(project)}/`}>{project.data.title}</a></h3>
          <p class="project-excerpt">{project.data.excerpt}</p>
          <dl class="fact-list">
            {project.data.homepageFacts.map((fact) => (
              <div><dt>{fact.label}</dt><dd>{fact.text}</dd></div>
            ))}
          </dl>
          <ul class="stack-list" aria-label="Stack">
            {project.data.stack.map((item) => <li>{item}</li>)}
          </ul>
          <a class="text-link" href={`/projects/${entrySlug(project)}/`}>Read the case study <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>
