---
import SectionHeader from "./SectionHeader.astro";
import ContributionBoard from "../ContributionBoard.astro";
import CaseStory from "./CaseStory.astro";
---

<section id="contributions" class="section">
  <div class="container">
    <SectionHeader
      index="01"
      title="Open source"
      link={{ href: "/contributions/", label: "All merged PRs" }}
    >
      <p class="section-lede">
        Fixes I needed in tools I use, sent upstream and merged after review.
      </p>
    </SectionHeader>

    <ContributionBoard />

    <CaseStory />
  </div>
</section>
