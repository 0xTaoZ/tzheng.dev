---
import SectionHeader from "./SectionHeader.astro";
import ContributionBoard from "../ContributionBoard.astro";
import { contributionCases, mergedPRs } from "../../lib/contributions";
const priority = ["cfn-lint", "pyinfra", "Prowler"];
const cases = [...contributionCases].sort(
  (a, b) => priority.indexOf(a.repository) - priority.indexOf(b.repository),
);
const countFor = (url: string) => {
  const repository = new URL(url).pathname.split("/").slice(1, 3).join("/");
  return mergedPRs.filter((pr) => pr.repository === repository).length;
};
---

<section id="contributions" class="section">
  <div class="container">
    <SectionHeader
      index="01"
      label="Open source"
      title="Open-source work"
      link={{ href: "/contributions/", label: "All merged PRs" }}
    >
      <p class="section-lede">
        When a security or infrastructure tool I use gets something wrong, I
        fix it upstream so every user receives the fix. Each change went
        through tests and maintainer review.
      </p>
    </SectionHeader>

    <ContributionBoard />

    <div class="case-grid">
      {cases.map((item) => (
        <article class="case-card reveal" data-upstream-case={item.repository}>
          <p class="case-meta">
            <span>{item.area}</span>
            <span>{countFor(item.url)} merged</span>
          </p>
          <h3>{item.repository}</h3>
          {"context" in item && <p class="case-context">{item.context}</p>}
          <p class="case-title">{item.title}</p>
          <p class="case-body">{item.change}</p>
          <p class="case-evidence">{item.evidence}</p>
          <a class="text-link" href={item.url}>
            Merged patch #{item.number} <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
