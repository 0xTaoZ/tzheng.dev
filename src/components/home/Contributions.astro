---
import {
  contributionCases,
  mergedPRs,
  mergedCount,
  repositoryCount,
  verifiedAt,
} from "../../lib/contributions";
const priority = ["cfn-lint", "pyinfra", "Prowler"];
const cases = [...contributionCases].sort(
  (a, b) => priority.indexOf(a.repository) - priority.indexOf(b.repository),
);
const countFor = (url: string) => {
  const repository = new URL(url).pathname.split("/").slice(1, 3).join("/");
  return mergedPRs.filter((pr) => pr.repository === repository).length;
};
---

<section id="contributions" class="py-32 px-6 max-w-7xl mx-auto">
  <div class="mb-14 reveal">
    <p class="section-kicker mb-4">Accepted upstream work</p>
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
      <div>
        <h2 class="text-5xl md:text-6xl font-bold text-white mb-4 tracking-tight">
          Open-source work.
        </h2>
        <p class="text-xl text-gray-400 font-light max-w-3xl">
          I contribute fixes to open-source security and infrastructure tools
          so other users can receive the same fix. Tests and maintainer review
          are part of that work.
        </p>
      </div>
      <a href="/contributions/" class="case-link">
        About the work &amp; all PRs <span>↗</span>
      </a>
    </div>
    <div class="flex flex-wrap gap-3 mt-7">
      <span class="chip">{mergedCount} merged upstream PRs</span>
      <span class="chip">{repositoryCount} repositories</span>
      <span class="chip">Verified {verifiedAt}</span>
    </div>
  </div>
  <div class="notes-grid-final">
    {cases.map((item) => (
      <article
        class="note-link-card reveal"
        data-upstream-case={item.repository}
      >
        <div class="flex items-center justify-between gap-4 mb-8">
          <span class="chip">{item.area}</span>
          <span class="text-xs text-gray-500 font-mono">
            {countFor(item.url)} merged PRs
          </span>
        </div>
        <h3 class="text-2xl font-bold text-white mb-4">{item.repository}</h3>
        {"context" in item && <p class="text-xs text-gray-500 font-mono mb-4">{item.context}</p>}
        <p class="text-white text-sm leading-relaxed mb-4">{item.title}</p>
        <p class="text-gray-400 text-sm leading-relaxed font-light">
          {item.change}
        </p>
        <p class="text-xs text-gray-500 font-mono mt-7">{item.evidence}</p>
        <a class="case-link" href={item.url}>
          Merged patch #{item.number} <span>↗</span>
        </a>
      </article>
    ))}
  </div>
</section>
