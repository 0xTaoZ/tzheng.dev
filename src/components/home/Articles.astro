---
import { getCollection } from "astro:content";
import SectionHeader from "./SectionHeader.astro";
import {
  entrySlug,
  articleMonth,
  monthLabel,
  byPublication,
  readingTime,
} from "../../lib/content";
const all = (
  await getCollection("articles", ({ data }) => data.status === "published")
).sort(byPublication);
const selected = all
  .filter((article) => article.data.homepageOrder !== undefined)
  .sort((a, b) => a.data.homepageOrder! - b.data.homepageOrder!)
  .slice(0, 3);
const latest = all.filter((article) => !selected.includes(article)).slice(0, 5);
const months = [...new Set(all.map(articleMonth))].sort().reverse();
---

<section id="notes" class="section">
  <div class="container">
    <SectionHeader
      index="04"
      title="Writing"
      link={{ href: "/articles/", label: `All ${all.length} articles` }}
    >
      <p class="section-lede">Notes from my projects, open-source fixes and study.</p>
    </SectionHeader>

    <div class="writing-grid">
      <div class="reveal">
        <p class="list-label">Selected</p>
        <ol class="selected-list">
          {selected.map((article) => (
            <li>
              <a href={`/articles/${entrySlug(article)}/`}>
                <span class="row-meta">{article.data.category} · {readingTime(article)}</span>
                <span class="row-title">{article.data.title}</span>
                <span class="row-excerpt">{article.data.excerpt}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <div class="reveal delay-1">
        <p class="list-label">Latest</p>
        <ol class="latest-list">
          {latest.map((article) => (
            <li>
              <a href={`/articles/${entrySlug(article)}/`}>
                <span class="row-kind">{article.data.category}</span>
                <span class="row-title">{article.data.title}</span>
              </a>
            </li>
          ))}
        </ol>
        <nav class="month-index" aria-label="Article archive by month">
          {months.map((month) => <a href={`/articles/#month-${month}`}>{monthLabel(month)}</a>)}
        </nav>
        <p class="feed-links">
          <a class="text-link" href="/articles/">Search the archive <span aria-hidden="true">→</span></a>
          <a class="text-link muted" href="/rss.xml">RSS</a>
        </p>
      </div>
    </div>
  </div>
</section>
