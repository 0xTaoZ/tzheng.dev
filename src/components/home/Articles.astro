---
import { getCollection } from "astro:content";
import { entrySlug, articleMonth, monthLabel, byPublication } from "../../lib/content";
const all = (await getCollection("articles", ({data}) => data.status === "published")).sort(byPublication);
const articles = all.filter(article => article.data.homepageOrder !== undefined).sort((a,b) => a.data.homepageOrder! - b.data.homepageOrder!).slice(0,3);
const months = [...new Set(all.map(articleMonth))].sort().reverse();
---

<section id="notes" class="py-32 px-6 max-w-7xl mx-auto">
  <div class="mb-16 text-center reveal">
    <p class="section-kicker mb-4">Technical writing</p>
    <h2 class="text-5xl md:text-6xl font-bold text-white mb-4 tracking-tight">
      Articles.
    </h2>
    <p class="text-xl text-gray-400 font-light max-w-3xl mx-auto">
      Notes from my projects, open-source fixes and study.
    </p>
  </div>
  <nav class="home-article-archive reveal" aria-label="Article archive">
    <a class="case-link" href="/articles/">All {all.length} articles · monthly archive &amp; search ↗</a>
    <a class="case-link" href="/rss.xml">RSS ↗</a>
  </nav>
  <div class="home-article-months reveal">
    {months.map(month => <a class="chip" href={`/articles/#month-${month}`}>{monthLabel(month)}</a>)}
  </div>
  <div class="notes-grid-final">
    {articles.map((article) => (
      <a
        class="note-link-card reveal"
        href={`/articles/${entrySlug(article)}/`}
      >
        <div class="flex items-center justify-between gap-4 mb-8">
          <span class="chip">{article.data.category}</span>
          <span class="text-xs text-gray-500 font-mono">
            {articleMonth(article)} series
          </span>
        </div>
        <h3 class="text-xl font-bold text-white mb-4">{article.data.title}</h3>
        <p class="text-gray-400 text-sm leading-relaxed font-light">
          {article.data.excerpt}
        </p>
        <span class="read-more">
          Read article <span>↗</span>
        </span>
        <div class="note-foot">
          <span>{article.data.tags.slice(0, 2).join(" · ")}</span>
          <span>{article.data.readingTime}</span>
        </div>
      </a>
    ))}
  </div>
</section>
