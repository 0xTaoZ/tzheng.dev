---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  keywords?: string | string[];
  ogImage?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "Haitao Zheng's cyber security portfolio, technical articles, and project system.",
  keywords,
  ogImage = "/logo.png",
  structuredData = []
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const canonicalUrl = canonical.toString();
const defaultKeywords = [
  "Haitao Zheng",
  "Zheng Haitao",
  "郑海涛",
  "鄭海濤",
  "Tao Zheng",
  "jensenzheng",
  "Haitao Zheng cyber security",
  "Haitao Zheng cybersecurity",
  "郑海涛 网络安全",
  "鄭海濤 網路安全",
  "cloud security",
  "blue team",
  "cyber security student",
  "security tooling",
  "IOC workflow",
  "CloudTrail",
  "Astro portfolio",
  "Cloudflare Pages",
  "GitHub portfolio",
  "Cyber Security Deutschland",
  "Cybersecurity Germany",
  "Cloud-Sicherheit",
  "IT-Sicherheit"
];
const pageKeywords = Array.isArray(keywords) ? keywords : keywords ? keywords.split(",") : [];
const metaKeywords = [...new Set([...defaultKeywords, ...pageKeywords].map((item) => item.trim()).filter(Boolean))].join(", ");
const extraStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://tzheng.dev/#person",
      name: "Haitao Zheng",
      alternateName: ["Zheng Haitao", "郑海涛", "鄭海濤", "Tao Zheng", "jensenzheng"],
      url: "https://tzheng.dev/",
      image: "https://tzheng.dev/logo.png",
      sameAs: ["https://github.com/0xTaoZ"],
      knowsAbout: [
        "Cyber Security",
        "Cloud Security",
        "Blue Team",
        "Security Tooling",
        "IOC Analysis",
        "CloudTrail",
        "Python",
        "Java",
        "TypeScript",
        "Astro",
        "Cloudflare Pages",
        "Static-first web architecture"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://tzheng.dev/#website",
      name: "tzheng.dev",
      alternateName: ["Haitao Zheng Portfolio", "郑海涛个人网站", "鄭海濤個人網站", "Tao Zheng Portfolio", "Jensen Zheng Cyber Security Portfolio"],
      url: "https://tzheng.dev/",
      description,
      publisher: { "@id": "https://tzheng.dev/#person" },
      inLanguage: ["en", "zh-CN", "zh-TW", "de"]
    },
    {
      "@type": "WebPage",
      "@id": canonicalUrl,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: { "@id": "https://tzheng.dev/#website" },
      about: { "@id": "https://tzheng.dev/#person" },
      primaryImageOfPage: new URL(ogImage, Astro.site).toString()
    },
    ...extraStructuredData.filter(Boolean)
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#030712" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={metaKeywords} />
    <meta name="author" content="Haitao Zheng" />
    <link rel="canonical" href={canonical} />
    <link rel="me" href="https://github.com/0xTaoZ" />
    <link rel="me" href="https://www.linkedin.com/in/haitaozheng/" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="Haitao Zheng RSS Feed" href="/rss.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <nav class="nav">
      <a class="brand logo-only" href="/" aria-label="Back to tzheng.dev home">
        <img src="/logo.png" alt="" />
      </a>
      <div class="nav-links">
        <a href="/#projects">Projects</a>
        <a href="/system/">System Design</a>
        <a href="/articles/">Articles</a>
        <a href="/#toolkit">Toolkit</a>
        <a href="/#education">Education</a>
        <a href="/#about">About</a>
        <a href="/legal/">Legal</a>
      </div>
    </nav>
    <a class="back-home" href="/">← Back to home</a>
    <slot />
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div>
          <p class="footer-kicker">Cloudflare edge · HTTPS-first · static attack surface</p>
          <p class="footer-security">This website is protected by Cloudflare Edge, delivered exclusively over HTTPS, built with a static architecture to minimize the attack surface, and designed with privacy by default.</p>
          <p>© 2026 Haitao Zheng. All rights reserved.</p>
        </div>
        <a class="system-link" href="/system/" aria-label="Read the tzheng.dev system design">
          <span>System Design</span>
          <small>Architecture, content system, security posture, and publishing workflow</small>
        </a>
        <a class="system-link" href="/topics/" aria-label="Read Haitao Zheng technical topics">
          <span>Topics</span>
          <small>Cyber security, IT systems, cloud security, blue team notes, and project keywords</small>
        </a>
      </div>
    </footer>
  </body>
</html>
