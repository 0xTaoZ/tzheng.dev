---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHead from "../components/SiteHead.astro";
interface Props {
  title: string;
  description?: string;
  keywords?: string | string[];
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article" | "profile";
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead {...Astro.props} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <nav class="nav">
      <a class="brand logo-only" href="/" aria-label="Back to tzheng.dev home">
        <img src="/img/logo-64.webp" alt="" width="32" height="32" />
      </a>
      <div class="nav-links">
        <a href="/#contributions">Contributions</a>
        <a href="/#projects">Projects</a>
        <a href="/system/">System Design</a>
        <a href="/articles/">Articles</a>
        <a href="/#toolkit">Toolkit</a>
        <a href="/#education">Education</a>
        <a href="/about/">About</a>
        <a href="/legal/">Legal</a>
      </div>
    </nav>
    <a class="back-home" href="/">
      ← Back to home
    </a>
    <slot />
    <SiteFooter />
  </body>
</html>
