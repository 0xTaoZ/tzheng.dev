---
import "../styles/global.css";
interface Props {
  title: string;
  description?: string;
  keywords?: string | string[];
  ogImage?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description = "Haitao Zheng — cyber security student, security-tool builder and upstream contributor to cloud and infrastructure projects.",
  ogImage = "/social-card.png",
  structuredData = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const navigation = [
  { label: "Work", href: "/projects/" },
  { label: "Open source", href: "/contributions/" },
  { label: "Writing", href: "/articles/" },
  { label: "About", href: "/about/" },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://tzheng.dev/#person",
      name: "Haitao Zheng",
      alternateName: ["郑海涛", "鄭海濤", "Tao Zheng"],
      url: "https://tzheng.dev/",
      image: "https://tzheng.dev/portrait.webp",
      sameAs: ["https://github.com/0xTaoZ"],
      knowsAbout: [
        "Cloud security",
        "Security tooling",
        "Python",
        "TypeScript",
        "Infrastructure engineering",
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://tzheng.dev/#website",
      name: "Haitao Zheng",
      url: "https://tzheng.dev/",
      publisher: { "@id": "https://tzheng.dev/#person" },
      inLanguage: "en",
    },
    {
      "@type": "WebPage",
      "@id": canonical.toString(),
      url: canonical.toString(),
      name: title,
      description,
      isPartOf: { "@id": "https://tzheng.dev/#website" },
      about: { "@id": "https://tzheng.dev/#person" },
    },
    ...(Array.isArray(structuredData) ? structuredData : [structuredData]),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f3ee" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Haitao Zheng" />
    <link rel="canonical" href={canonical} />
    <link rel="me" href="https://github.com/0xTaoZ" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/source-serif-4-display.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Haitao Zheng — security tooling and cloud infrastructure"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Haitao Zheng — Writing"
      href="/rss.xml"
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd).replaceAll("<", "\\u003c")}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="site-header shell">
      <a class="brand" href="/" aria-label="Haitao Zheng — home">
        <span class="brand-mark" aria-hidden="true">
          hz.
        </span>
        <span>
          Haitao Zheng<span class="brand-sub">Security & infrastructure</span>
        </span>
      </a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        {navigation.map((item) => (
          <a
            href={item.href}
            aria-current={path.startsWith(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <a class="header-contact" href="mailto:h@tzheng.dev">
        Get in touch <span aria-hidden="true">↗</span>
      </a>
      <details class="mobile-nav">
        <summary>
          Menu <span aria-hidden="true">＋</span>
        </summary>
        <nav aria-label="Mobile navigation">
          {navigation.map((item) => (
            <a
              href={item.href}
              aria-current={path.startsWith(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
          <a href="mailto:h@tzheng.dev">Get in touch ↗</a>
        </nav>
      </details>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div class="footer-top">
        <p>
          Careful work.
          <br />
          <span class="serif">Useful outcomes.</span>
        </p>
        <a class="contact-email" href="mailto:h@tzheng.dev">
          h@tzheng.dev <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getUTCFullYear()} Haitao Zheng</span>
        <nav aria-label="Footer navigation">
          <a href="https://github.com/0xTaoZ">GitHub ↗</a>
          <a href="/system/">Colophon</a>
          <a href="/rss.xml">RSS</a>
          <a href="/legal/#impressum">Impressum</a>
          <a href="/legal/#datenschutz">Privacy</a>
        </nav>
        <a href="#main-content">Back to top ↑</a>
      </div>
    </footer>
  </body>
</html>
