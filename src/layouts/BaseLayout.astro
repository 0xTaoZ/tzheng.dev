---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHead from "../components/SiteHead.astro";
interface Props {
  title: string;
  description?: string;
  keywords?: string | string[];
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article" | "profile";
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}
const links = [
  { href: "/contributions/", label: "Open source" },
  { href: "/projects/", label: "Projects" },
  { href: "/articles/", label: "Articles" },
  { href: "/about/", label: "About" },
  { href: "/resume/", label: "Résumé" },
];
const path = Astro.url.pathname;
const current = (href: string) => path === href || path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead {...Astro.props} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="nav">
      <div class="nav-inner">
        <a class="wordmark" href="/" aria-label="Haitao Zheng, home">
          <img src="/img/logo-64.webp" alt="" width="28" height="28" />
          <span>Haitao Zheng</span>
        </a>
        <nav class="nav-links" aria-label="Site">
          {links.map((link) => (
            <a href={link.href} aria-current={current(link.href) ? "page" : undefined}>{link.label}</a>
          ))}
        </nav>
        <details class="nav-menu">
          <summary aria-label="Open navigation"><span></span><span></span></summary>
          <nav aria-label="Site menu">
            <a href="/">Home</a>
            {links.map((link) => <a href={link.href}>{link.label}</a>)}
            <a href="/topics/">Topics</a>
            <a href="/system/">System design</a>
          </nav>
        </details>
      </div>
    </header>
    <slot />
    <SiteFooter />
  </body>
</html>
