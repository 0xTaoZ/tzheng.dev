---
import BaseLayout from "../layouts/BaseLayout.astro";
const topics = [
  {
    group: "Cloud investigation",
    summary:
      "Local CloudTrail review, IAM risk and Kubernetes security checks.",
    items: ["AWS", "Python", "Kubernetes"],
    links: [
      {
        title: "CloudTrail Quickscan",
        href: "/projects/cloudtrail-quickscan/",
      },
      { title: "Prowler contributions", href: "/contributions/#prowler" },
      { title: "IAM boundary-removal analysis", href: "/articles/permissions-boundary-removal/" },
      { title: "Pod volume evidence", href: "/articles/pod-evidence-before-check/" },
    ],
  },
  {
    group: "Infrastructure & validation",
    summary:
      "SSH host identity and CloudFormation lifecycle-policy validation.",
    items: ["SSH", "pyinfra", "CloudFormation"],
    links: [
      {
        title: "SSH certificate trust",
        href: "/articles/ssh-trust-boundaries/",
      },
      {
        title: "cfn-lint contributions",
        href: "/projects/cfn-lint-contribution/",
      },
    ],
  },
  {
    group: "Logs & indicators",
    summary:
      "Small tools for inspecting local evidence and producing readable results.",
    items: ["JSONL", "Java", "C"],
    links: [
      { title: "JSONL Lens", href: "/projects/jsonl-lens/" },
      { title: "Missing, null and type drift", href: "/articles/jsonl-missing-null-types/" },
      {
        title: "Sentinel IOC Toolkit",
        href: "/projects/sentinel-ioc-toolkit/",
      },
    ],
  },
  {
    group: "Learning products",
    summary: "Study workflows, recall evidence and deterministic reward rules.",
    items: ["TypeScript", "React", "Worker APIs"],
    links: [
      { title: "StudyPulse", href: "/projects/studypulse/" },
      {
        title: "Scoring boundaries",
        href: "/articles/results-before-rewards/",
      },
    ],
  },
  {
    group: "Frontend & publishing",
    summary:
      "Typed content, shared components and static delivery for this site.",
    items: ["Astro", "Markdown", "GitHub Pages"],
    links: [
      {
        title: "Content Collections",
        href: "/articles/astro-content-system-notes/",
      },
      { title: "System Design", href: "/system/" },
    ],
  },
];
---

<BaseLayout
  title="Topics | Haitao Zheng"
  description="Browse technical work by subject, with links to projects and implementation notes."
>
  <main id="main-content" tabindex="-1" class="shell">
    <section>
      <div class="section-head">
        <span class="eyebrow">Browse the work</span>
        <h1>Topics.</h1>
        <p>
          Start with a technical area, then follow the case studies and
          implementation notes.
        </p>
      </div>
      <div class="grid">
        {topics.map((topic, index) => (
          <article
            class:list={[
              "card",
              index === 0 && "featured",
              index > 0 && "compact",
            ]}
          >
            <div class="meta">
              <span>{topic.group}</span>
            </div>
            <h3>{topic.group}</h3>
            <p>{topic.summary}</p>
            <div class="meta">
              {topic.items.map((item) => (
                <span class="chip">{item}</span>
              ))}
            </div>
            {topic.links.map((link) => (
              <p>
                <a class="link" href={link.href}>
                  {link.title} ↗
                </a>
              </p>
            ))}
          </article>
        ))}
      </div>
      <article class="card featured" style="margin-top:2rem">
        <div class="meta">
          <span>Source and review</span>
        </div>
        <h3>Follow the work.</h3>
        <p>
          The{" "}
          <a class="link" href="/projects/">
            project index
          </a>{" "}
          explains scope and validation. The{" "}
          <a class="link" href="/contributions/">
            contribution record
          </a>{" "}
          links merged upstream patches.{" "}
          <a class="link" href="/articles/">
            Articles
          </a>{" "}
          cover individual implementation decisions.
        </p>
      </article>
    </section>
  </main>
</BaseLayout>
