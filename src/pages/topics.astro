---
import BaseLayout from "../layouts/BaseLayout.astro";
const topics = [
  {
    name: "Cloud investigation",
    description: "Audit logs, permissions and exposure changes.",
    href: "/projects/cloudtrail-quickscan/",
  },
  {
    name: "Infrastructure correctness",
    description: "SSH trust, connectors and deployment validation.",
    href: "/contributions/",
  },
  {
    name: "Evidence and product rules",
    description:
      "A learning product with explicit grading and reward boundaries.",
    href: "/projects/studypulse/",
  },
  {
    name: "Data inspection",
    description: "Field gaps, schema drift and useful grouping signals.",
    href: "/projects/jsonl-lens/",
  },
  {
    name: "Local security tools",
    description: "Access logs, authentication events, IOCs and socket state.",
    href: "/projects/",
  },
];
---

<BaseLayout
  title="Topics — Haitao Zheng"
  description="Explore the work by technical question: cloud investigation, infrastructure correctness, product evidence and data inspection."
>
  <div class="shell page-content">
    <header class="page-header">
      <span class="eyebrow">Topics / a route through the work</span>
      <h1>Follow a question.</h1>
      <p>
        Different entry points into the same practice: understand the system,
        inspect the evidence, make a useful change.
      </p>
    </header>
    <div class="topic-list">
      {topics.map((topic) => (
        <a href={topic.href}>
          <div>
            {topic.name}
            <p style="font-size:14px;margin-top:10px;color:var(--muted)">
              {topic.description}
            </p>
          </div>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
