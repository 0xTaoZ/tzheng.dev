---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  mergedPRs,
  mergedCount,
  repositoryCount,
  verifiedAt,
  contributionCases,
} from "../lib/contributions";
const repositoryGroups = [...new Set(mergedPRs.map((pr) => pr.repository))].map(
  (name) => ({ name, prs: mergedPRs.filter((pr) => pr.repository === name) }),
);
---

<BaseLayout
  title="Open-source work | Haitao Zheng"
  description="Verified merged contributions to pyinfra, cfn-lint, Prowler and other upstream projects, with technical context and direct evidence."
>
  <main id="main-content" tabindex="-1" class="article-body">
    <header class="page-header">
      <span class="eyebrow">Open source / accepted work</span>
      <h1>Open-source work.</h1>
      <p>
        Accepted fixes to cloud, security and infrastructure projects, with the
        reported failure, patch and review linked below.
      </p>
    </header>
    <div class="meta">
      <div>
        <strong>{mergedCount}</strong>
        <span>Merged upstream pull requests</span>
      </div>
      <div>
        <strong>{repositoryCount}</strong>
        <span>Upstream repositories</span>
      </div>
      <div>
        <strong>{verifiedAt.slice(0, 4)}</strong>
        <span>Year of the verified record</span>
      </div>
    </div>
    <p class="note" style="margin-bottom:35px">
      Snapshot verified {verifiedAt}. Includes code, tests and documentation.
      Own repositories, unmerged proposals and closed PRs are excluded.{" "}
      <a href="https://github.com/search?q=author%3A0xTaoZ+is%3Apr+is%3Amerged+-user%3A0xTaoZ&type=pullrequests">
        Check the live GitHub record ↗
      </a>
    </p>
    <section id="why" class="card" style="margin:2rem 0">
      <h2>Why contribute upstream?</h2>
      <p>I contribute fixes to open-source security and infrastructure tools.
        Returning a fix to the project lets other users receive it too, instead
        of keeping the same workaround in their own copy.</p>
      <p>The work includes reading existing code, reproducing the problem,
        adding tests and going through review. The cases below link to the
        accepted patch so the change can be checked directly.</p>
      <a class="link" href="/articles/why-contribute-upstream/">Read the contribution approach ↗</a>
    </section>
    {contributionCases.map((item) => (
      <section
        id={item.repository.toLowerCase()}
        class="card"
        style="margin:2rem 0"
      >
        <div>
          <span class="eyebrow">{item.area}</span>
          <h2>{item.repository}</h2>
          {"context" in item && <p>{item.context}</p>}
          <p class="meta">#{item.number} / Merged</p>
        </div>
        <div>
          <h3>{item.title}</h3>
          <p>
            <strong>Problem.</strong> {item.problem}
          </p>
          <p>
            <strong>Change.</strong> {item.change}
          </p>
          <p>
            <strong>Reason.</strong> {item.lesson}
          </p>
          <p class="note">{item.evidence}</p>
          <a class="link" href={item.url}>
            Read the patch and review <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    ))}
    <section class="section" style="border-bottom:0" id="record">
      <span class="eyebrow">The merged record / {verifiedAt}</span>
      <h2>Merged pull requests.</h2>
      <p style="margin:22px 0 35px;color:var(--muted)">
        A count is only useful if it can be checked. Every entry below links to
        a merged upstream pull request.
      </p>
      <div class="table-scroll">
        <table class="pr-ledger">
          <caption class="note" style="text-align:left;margin-bottom:15px">
            Merged pull requests authored by 0xTaoZ, grouped by upstream
            repository.
          </caption>
          <thead>
            <tr>
              <th scope="col">Repository</th>
              <th scope="col">Change</th>
              <th scope="col">Record</th>
            </tr>
          </thead>
          <tbody>
            {repositoryGroups.flatMap((group) =>
              group.prs.map((pr) => (
                <tr>
                  <td>
                    {group.name}
                    <span class="merge-label">Merged</span>
                  </td>
                  <td>{pr.title}</td>
                  <td>
                    <a href={pr.url}>#{pr.number} ↗</a>
                  </td>
                </tr>
              )),
            )}
          </tbody>
        </table>
      </div>
    </section>
    <p class="note">
      I am a contributor to these projects, not their maintainer or an employee
      of the organizations behind them. Work still under review is visible on{" "}
      <a href="https://github.com/search?q=author%3A0xTaoZ+is%3Apr+is%3Aopen+-user%3A0xTaoZ&type=pullrequests">
        GitHub ↗
      </a>
      .
    </p>
  </main>
</BaseLayout>
