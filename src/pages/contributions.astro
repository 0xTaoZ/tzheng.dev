---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContributionBoard from "../components/ContributionBoard.astro";
import {
  mergedPRs,
  mergedCount,
  verifiedAt,
  contributionCases,
  compactNumber,
  openCount,
  openPRs,
  upstreamRepositories,
} from "../lib/contributions";
import { entrySlug, formatDate } from "../lib/content";
import { disclosures } from "../data/disclosures";
const repositoryGroups = upstreamRepositories.map((repository) => ({
  ...repository,
  prs: mergedPRs
    .filter((pr) => pr.repository === repository.name)
    .sort((a, b) => b.mergedAt.localeCompare(a.mergedAt)),
}));
// Link each merged PR to the article that explains it, when one exists.
const articles = await getCollection("articles", ({ data }) => data.status === "published");
const writeUp = (url: string) =>
  articles.find((article) => article.body?.includes(`${url})`));
const schema = {
  "@type": "CollectionPage",
  "@id": "https://tzheng.dev/contributions/#record",
  name: "Open-source contributions by Haitao Zheng",
  url: "https://tzheng.dev/contributions/",
  author: { "@id": "https://tzheng.dev/#person" },
  dateModified: `${verifiedAt}T00:00:00Z`,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: mergedCount,
    itemListElement: mergedPRs.map((pr, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: pr.url,
      name: `${pr.repository}#${pr.number}: ${pr.title}`,
    })),
  },
};
---

<BaseLayout
  title="Open-source work | Haitao Zheng"
  description={`${mergedCount} merged pull requests by Haitao Zheng to ${upstreamRepositories.map((repository) => repository.label).join(", ")}, with technical context and direct links.`}
  ogImage="/og/contributions.png"
  structuredData={schema}
>
  <main id="main-content" tabindex="-1" class="shell contrib">
    <header class="page-header contrib-intro">
      <h1>Open-source work</h1>
      <p>
        Accepted fixes to cloud, security and infrastructure projects, with the
        reported failure, patch and review linked below.
      </p>
      <p class="note">
        Snapshot verified {verifiedAt}. Includes code, tests and documentation.
        Own repositories, unmerged proposals and closed PRs are excluded.{" "}
        <a href="https://github.com/search?q=author%3A0xTaoZ+is%3Apr+is%3Amerged+-user%3A0xTaoZ&type=pullrequests">Check the live GitHub record ↗</a>
      </p>
    </header>

    <ContributionBoard />

    {disclosures.map((item) => (
      <section id="disclosure" class="disclosure-record">
        <h2>{item.id}</h2>
        <p>{item.product}. {item.summary}</p>
        <p>{item.status}</p>
      </section>
    ))}

    <div class="contrib-columns">
      <section id="why" class="contrib-why">
        <h2>Why contribute upstream?</h2>
        <p>I contribute fixes to open-source security and infrastructure tools.
          Returning a fix to the project lets other users receive it too, instead
          of keeping the same workaround in their own copy.</p>
        <p>The work includes reading existing code, reproducing the problem,
          adding tests and going through review. The cases below link to the
          accepted patch so the change can be checked directly.</p>
        <a class="link" href="/articles/why-contribute-upstream/">Read the contribution approach ↗</a>
      </section>
      <div class="contrib-cases">
        {contributionCases.map((item) => (
          <section id={item.repository.toLowerCase()} class="card case">
            <h2>{item.repository} <span class="case-number">#{item.number}</span></h2>
            <p class="note">{item.area}</p>
            {"context" in item && <p class="meta">{item.context}</p>}
            <h3>{item.title}</h3>
            <dl class="case-steps">
              <div><dt>Problem</dt><dd>{item.problem}</dd></div>
              <div><dt>Change</dt><dd>{item.change}</dd></div>
              <div><dt>Reason</dt><dd>{item.lesson}</dd></div>
            </dl>
            <p class="note">{item.evidence}</p>
            <a class="link" href={item.url}>Read the patch and review <span aria-hidden="true">↗</span></a>
          </section>
        ))}
      </div>
    </div>

    <section class="ledger" id="record">
      <h2>Merged pull requests</h2>
      <p class="note">Checked on {verifiedAt}</p>
      <p class="note">
        A count is only useful if it can be checked. Every entry below links to
        a merged upstream pull request, grouped by repository.
      </p>
      {repositoryGroups.map((group) => (
        <section class="ledger-group" id={`repo-${group.repo}`}>
          <header class="ledger-head">
            <h3><a href={group.url}><span class="repo-owner">{group.owner}/</span>{group.repo}</a></h3>
            <p class="meta">{group.prs.length} merged, {compactNumber(group.stars)} stars</p>
          </header>
          <ol class="ledger-list">
            {group.prs.map((pr) => {
              const article = writeUp(pr.url);
              return (
                <li>
                  <time datetime={pr.mergedAt}>{formatDate(new Date(`${pr.mergedAt}T00:00:00Z`), "short")}</time>
                  <span class="ledger-title">
                    <a href={pr.url}>{pr.title}</a>
                    {article && (
                      <a class="writeup" href={`/articles/${entrySlug(article)}/`}>Write-up: {article.data.title}</a>
                    )}
                  </span>
                  <a class="ledger-number" href={pr.url}>#{pr.number}</a>
                </li>
              );
            })}
          </ol>
        </section>
      ))}
    </section>

    <section class="ledger" id="in-review">
      <h2>Open pull requests</h2>
      <p class="note">Checked on {verifiedAt}</p>
      <p class="note">
        {openCount} proposals waiting for maintainer review. They are not counted
        above until they are merged, and some may be closed without merging.
      </p>
      <ol class="ledger-list open">
        {openPRs.map((pr) => (
          <li>
            <time datetime={pr.openedAt}>{formatDate(new Date(`${pr.openedAt}T00:00:00Z`), "short")}</time>
            <span class="ledger-title">
              <a href={pr.url}>{pr.title}</a>
              <span class="ledger-repo">{pr.repository}</span>
            </span>
            <a class="ledger-number" href={pr.url}>#{pr.number}</a>
          </li>
        ))}
      </ol>
    </section>

    <p class="note contrib-disclaimer">
      I am a contributor to these projects, not their maintainer or an employee
      of the organizations behind them. Work still under review is visible on{" "}
      <a href="https://github.com/search?q=author%3A0xTaoZ+is%3Apr+is%3Aopen+-user%3A0xTaoZ&type=pullrequests">GitHub ↗</a>.
    </p>
  </main>
</BaseLayout>
