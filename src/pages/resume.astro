---
import "../styles/resume.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { mergedCount, verifiedAt } from "../lib/contributions";
import { header, education, security, openSource, otherOpenSource, projects, skills } from "../data/resume";

const verifiedLabel = new Date(`${verifiedAt}T00:00:00Z`).toLocaleDateString(
  "en",
  { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" },
);
const schema = {
  "@type": "ProfilePage",
  "@id": "https://tzheng.dev/resume/#profile",
  url: "https://tzheng.dev/resume/",
  name: "Haitao Zheng résumé",
  mainEntity: { "@id": "https://tzheng.dev/#person" },
  dateModified: `${verifiedAt}T00:00:00Z`,
};
---

<BaseLayout
  title="Résumé | Haitao Zheng, Cyber Security & Privacy student"
  description={`Résumé of Haitao Zheng: B.Sc. Cyber Security & Privacy at H-BRS, ${mergedCount} merged pull requests to pyinfra, cfn-lint, Prowler, Trivy and others, and security tools.`}
  ogType="profile"
  ogImage="/og/resume.png"
  structuredData={schema}
>
  <main id="main-content" tabindex="-1" class="resume-page">
    <div class="resume-toolbar" data-print-hide>
      <p>Updated {verifiedLabel}</p>
      <span class="resume-actions">
        <a class="button primary" href="/haitao-zheng-resume.pdf" download>PDF</a>
        <a class="button" href="/resume.md">Markdown</a>
        <button class="button" type="button" data-print>Print</button>
      </span>
    </div>

    <article class="sheet">
      <header class="cv-head">
        <h1>{header.name}</h1>
        <p class="cv-title">{header.title}</p>
        <p class="cv-contact">
          {header.contact.map((item) => (item.url ? <a href={item.url}>{item.label}</a> : <span>{item.label}</span>))}
        </p>
      </header>

      <section class="cv-section">
        <h2>Education</h2>
        {education.map((item) => (
          <div class="cv-row">
            <p><b>{item.school}</b><span class="cv-sep">·</span>{item.detail}{item.note && <span class="cv-note"><span class="cv-sep">·</span>{item.note}</span>}</p>
            <p class="cv-date">{item.when}</p>
          </div>
        ))}
      </section>

      <section class="cv-section">
        <h2>Security</h2>
        {security.map((item) => (
          <div class="cv-row">
            <p><b>{item.id}</b><span class="cv-sep">·</span>{item.product}<span class="cv-note"><span class="cv-sep">·</span>{item.text}</span></p>
          </div>
        ))}
      </section>

      <section class="cv-section">
        <h2>Open source</h2>
        {openSource.map((item) => (
          <div class="cv-entry">
            <div class="cv-row">
              <p><b><a href={item.url}>{item.title}</a></b> <span class="cv-org">{item.about}</span></p>
              <p class="cv-date">{item.count} merged PRs<span class="cv-sep">·</span>{item.when}</p>
            </div>
            <ul>
              {item.points.map((point) => (
                <li>
                  {point.text}{" "}
                  <span class="cv-refs">{point.refs.map((ref) => <a href={ref.url}>{ref.label}</a>)}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <div class="cv-entry">
          <div class="cv-row">
            <p><b>Also merged</b></p>
            <p class="cv-date">{otherOpenSource.when}</p>
          </div>
          <p class="cv-inline">
            {otherOpenSource.items.map((item) => (
              <span><b>{item.title}</b> {item.text} <a class="cv-refs" href={item.ref.url}>{item.ref.label}</a></span>
            ))}
          </p>
        </div>
      </section>

      <section class="cv-section">
        <h2>Projects</h2>
        {projects.map((item) => (
          <div class="cv-entry">
            <p><b><a href={item.url}>{item.title}</a></b> <span class="cv-org">{item.stack}</span></p>
            <p class="cv-text">{item.text}</p>
          </div>
        ))}
      </section>

      <section class="cv-section">
        <h2>Skills</h2>
        <dl class="cv-skills">
          {skills.map((item) => <div><dt>{item.label}</dt><dd>{item.text}</dd></div>)}
        </dl>
      </section>
    </article>
  </main>
  <script>
    document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
  </script>
</BaseLayout>
