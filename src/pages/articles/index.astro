---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { entrySlug, articleMonth, monthLabel, byPublication } from "../../lib/content";
const articles = (await getCollection("articles", ({ data }) => data.status === "published")).sort(byPublication);
const months = [...new Set(articles.map(articleMonth))].sort().reverse();
const categories = [...new Set(articles.map(article => article.data.category))].sort();
const schema = {
  "@type": "CollectionPage", name: "Articles by Haitao Zheng",
  url: "https://tzheng.dev/articles/", author: { "@id": "https://tzheng.dev/#person" },
  hasPart: articles.map(article => ({
    "@type": "Article", headline: article.data.title,
    url: new URL(`/articles/${entrySlug(article)}/`, Astro.site).toString(),
    datePublished: article.data.date.toISOString(),
  })),
};
---
<BaseLayout title="Articles | Haitao Zheng" description="Security engineering articles, source-linked case analyses and a monthly learning archive." structuredData={schema}>
  <main id="main-content" tabindex="-1" class="shell">
    <section>
      <div class="section-head">
        <span class="eyebrow">Security engineering / monthly reading series</span>
        <h1>Articles.</h1>
        <p>Notes from my security tools, open-source fixes and study. Some cover a small code change; others explain a topic I am learning.</p>
        <p class="archive-note">{articles.length} articles across {months.length} monthly reading groups. Months group related work and study topics. Older notes keep their original dates. New companion articles show when they were written; their series month groups the topic.</p>
        <a class="link" href="/rss.xml">Subscribe via RSS ↗</a>
      </div>
      <nav class="archive-months" aria-label="Monthly reading archive">
        {months.map(month => <a class="chip" href={`#month-${month}`}>{monthLabel(month)} <span>({articles.filter(article => articleMonth(article) === month).length})</span></a>)}
      </nav>
      <form class="article-filters" role="search" onsubmit="return false">
        <label>Search articles<input type="search" id="article-search" name="q" placeholder="Title, topic or keyword" /></label>
        <label>Category<select id="article-category" name="category"><option value="">All categories</option>{categories.map(category => <option value={category}>{category}</option>)}</select></label>
        <button class="button" type="reset">Clear filters</button>
      </form>
      <p id="article-results" class="meta" aria-live="polite">Showing {articles.length} articles</p>
      <p id="article-empty" hidden>No matching articles. Try a broader term or clear the filters.</p>
      <div id="article-archive">
        {months.map(month => <section id={`month-${month}`} class="archive-group" data-archive-month={month}>
          <h2>{monthLabel(month)}</h2>
          <div class="grid">
            {articles.filter(article => articleMonth(article) === month).map(article => <article class="card" data-article-card data-category={article.data.category} data-search={[article.data.title,article.data.excerpt,article.data.category,...article.data.tags, article.body ?? ""].join(" ").toLowerCase()}>
              <div class="meta"><span>{article.data.category}</span><span>{article.data.readingTime}</span></div>
              <h3><a href={`/articles/${entrySlug(article)}/`}>{article.data.title}</a></h3>
              <p>{article.data.excerpt}</p>
              <p class="meta">Published <time datetime={article.data.date.toISOString().slice(0,10)}>{article.data.date.toLocaleDateString("en",{month:"short",day:"numeric",year:"numeric",timeZone:"UTC"})}</time>{article.data.seriesMonth && <span> · Series: {monthLabel(month)}</span>}</p>
              <div class="meta">{article.data.tags.map(tag => <span class="chip">{tag}</span>)}</div>
              <a class="link" href={`/articles/${entrySlug(article)}/`}>Read article ↗</a>
            </article>)}
          </div>
        </section>)}
      </div>
    </section>
  </main>
  <script>
    const search = document.querySelector<HTMLInputElement>("#article-search")!;
    const category = document.querySelector<HTMLSelectElement>("#article-category")!;
    const cards = [...document.querySelectorAll<HTMLElement>("[data-article-card]")];
    const groups = [...document.querySelectorAll<HTMLElement>("[data-archive-month]")];
    const update = () => {
      const terms = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let count = 0;
      for (const card of cards) {
        card.hidden = !terms.every(term => card.dataset.search!.includes(term)) || (!!category.value && card.dataset.category !== category.value);
        if (!card.hidden) count++;
      }
      for (const group of groups) group.hidden = ![...group.querySelectorAll<HTMLElement>("[data-article-card]")].some(card => !card.hidden);
      document.querySelector("#article-results")!.textContent = `Showing ${count} of ${cards.length} articles`;
      (document.querySelector("#article-empty") as HTMLElement).hidden = count !== 0;
    };
    document.querySelectorAll<HTMLAnchorElement>(".archive-months a").forEach(link => link.addEventListener("click", () => { search.value=""; category.value=""; update(); }));
    search.addEventListener("input", update);
    category.addEventListener("change", update);
    document.querySelector(".article-filters")!.addEventListener("reset", () => { search.value=""; category.value=""; update(); });
  </script>
</BaseLayout>
