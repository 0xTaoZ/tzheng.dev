---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { entrySlug } from "../../lib/content";
export async function getStaticPaths() {
  return (
    await getCollection("articles", ({ data }) => data.status === "published")
  ).map((article) => ({
    params: { slug: entrySlug(article) },
    props: { article },
  }));
}
const { article } = Astro.props;
const all = (
  await getCollection("articles", ({ data }) => data.status === "published")
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const index = all.findIndex((item) => entrySlug(item) === entrySlug(article));
const previous = all[index + 1],
  next = all[index - 1];
const { Content, headings } = await render(article);
const url = new URL(`/articles/${entrySlug(article)}/`, Astro.site).toString();
const schema = {
  "@type": "Article",
  headline: article.data.title,
  description: article.data.excerpt,
  url,
  datePublished: article.data.date.toISOString(),
  dateModified: (article.data.updated ?? article.data.date).toISOString(),
  author: { "@id": "https://tzheng.dev/#person" },
  publisher: { "@id": "https://tzheng.dev/#website" },
  mainEntityOfPage: url,
};
const related = all
  .filter(
    (item) =>
      entrySlug(item) !== entrySlug(article) &&
      item.data.tags.some((tag) => article.data.tags.includes(tag)),
  )
  .slice(0, 3);
---

<BaseLayout
  title={`${article.data.title} — Haitao Zheng`}
  description={article.data.excerpt}
  structuredData={schema}
>
  <article class="article-body">
    <a class="text-link" href="/articles/">
      ← All writing
    </a>
    <h1>{article.data.title}</h1>
    <div class="meta">
      <time datetime={article.data.date.toISOString()}>
        {article.data.date.toLocaleDateString("en-GB", {
          day: "numeric",
          month: "long",
          year: "numeric",
          timeZone: "UTC",
        })}
      </time>
      <span>{article.data.category}</span>
      <span>{article.data.readingTime}</span>
    </div>
    <p class="lead">{article.data.excerpt}</p>
    {article.data.updated && (
      <p class="note">
        Updated{" "}
        {article.data.updated.toLocaleDateString("en-GB", {
          day: "numeric",
          month: "long",
          year: "numeric",
          timeZone: "UTC",
        })}
      </p>
    )}
    {headings.length > 0 && (
      <nav class="toc" aria-label="On this page">
        <strong>On this page</strong>
        {headings
          .filter((h) => h.depth === 2)
          .map((h) => (
            <a href={`#${h.slug}`}>{h.text}</a>
          ))}
      </nav>
    )}
    <Content />
    <div class="article-pager">
      {previous && (
        <a href={`/articles/${entrySlug(previous)}/`}>
          <span>Earlier note</span>← {previous.data.title}
        </a>
      )}
      {next && (
        <a href={`/articles/${entrySlug(next)}/`}>
          <span>Newer note</span>
          {next.data.title} →
        </a>
      )}
    </div>
    {related.length > 0 && (
      <aside class="related">
        <span class="eyebrow">Related reading</span>
        {related.map((item) => (
          <a href={`/articles/${entrySlug(item)}/`}>{item.data.title} ↗</a>
        ))}
      </aside>
    )}
  </article>
</BaseLayout>
