---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  entrySlug,
  monthLabel,
  byPublication,
  formatDate,
  readingTime,
  relatedArticles,
} from "../../lib/content";

export async function getStaticPaths() {
  const articles = await getCollection(
    "articles",
    ({ data }) => data.status === "published",
  );
  return articles.map((article) => ({
    params: { slug: entrySlug(article) },
    props: { article },
  }));
}

const { article } = Astro.props;
const all = (
  await getCollection("articles", ({ data }) => data.status === "published")
).sort(byPublication);
const projects = await getCollection("projects");
const relatedProject = article.data.project ? projects.find(project => entrySlug(project) === article.data.project) : undefined;
if (article.data.project && !relatedProject) throw new Error(`Unknown article project: ${article.data.project}`);
const slug = entrySlug(article);
const index = all.findIndex((item) => entrySlug(item) === slug);
const previous = all[index + 1];
const next = all[index - 1];
const { Content, headings } = await render(article);
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
const articleUrl = new URL(`/articles/${slug}/`, Astro.site).toString();
const articleKeywords = [article.data.category, ...article.data.tags];
const ogImage = `/og/articles/${slug}.png`;
const minutes = readingTime(article);
const articleSchema = {
  "@type": "TechArticle",
  "@id": `${articleUrl}#article`,
  headline: article.data.title,
  description: article.data.excerpt,
  url: articleUrl,
  image: new URL(ogImage, Astro.site).toString(),
  inLanguage: "en",
  datePublished: article.data.date.toISOString(),
  dateModified: (article.data.updated ?? article.data.date).toISOString(),
  author: { "@id": "https://tzheng.dev/#person" },
  publisher: { "@id": "https://tzheng.dev/#person" },
  isPartOf: { "@id": "https://tzheng.dev/#website" },
  mainEntityOfPage: articleUrl,
  articleSection: article.data.category,
  keywords: articleKeywords,
  timeRequired: `PT${parseInt(minutes, 10) || 1}M`,
  ...(relatedProject && {
    about: {
      "@type": "SoftwareSourceCode",
      name: relatedProject.data.title,
      url: new URL(`/projects/${entrySlug(relatedProject)}/`, Astro.site).toString(),
    },
  }),
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${articleUrl}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://tzheng.dev/" },
    { "@type": "ListItem", position: 2, name: "Articles", item: "https://tzheng.dev/articles/" },
    { "@type": "ListItem", position: 3, name: article.data.title, item: articleUrl },
  ],
};

const related = relatedArticles(article, all);
---

<BaseLayout
  title={`${article.data.title} | Haitao Zheng`}
  description={article.data.excerpt}
  keywords={articleKeywords}
  ogImage={ogImage}
  ogImageAlt={article.data.title}
  ogType="article"
  publishedTime={article.data.date}
  modifiedTime={article.data.updated ?? article.data.date}
  tags={articleKeywords}
  structuredData={[articleSchema, breadcrumbSchema]}
>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <main id="main-content" tabindex="-1" class="article-body">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/articles/">Articles</a>
      <span aria-hidden="true">/</span>
      <a href={`/articles/?category=${encodeURIComponent(article.data.category)}`}>{article.data.category}</a>
    </nav>
    <article class="prose">
      <header class="article-header">
        <h1>{article.data.title}</h1>
        <p class="article-lede">{article.data.excerpt}</p>
        <div class="meta">
          <span>
            Published <time datetime={article.data.date.toISOString().slice(0, 10)}>{formatDate(article.data.date)}</time>
          </span>
          {article.data.updated && (
            <span>
              Updated <time datetime={article.data.updated.toISOString().slice(0, 10)}>{formatDate(article.data.updated)}</time>
            </span>
          )}
          <span>{article.data.category}</span>
          <span>{minutes} read</span>
        </div>
        <div class="meta tag-row">
          {article.data.tags.map((tag) => <span class="chip">#{tag}</span>)}
        </div>
        {article.data.seriesMonth && <p class="note">Reading series: <a href={`/articles/#month-${article.data.seriesMonth}`}>{monthLabel(article.data.seriesMonth)}</a>. This grouping describes the topic or work discussed, not the publication date.</p>}
        {relatedProject && <p class="meta project-ref">Project: <a class="link" href={`/projects/${entrySlug(relatedProject)}/`}>{relatedProject.data.title} ↗</a></p>}
      </header>
      {tocHeadings.length > 1 && (
        <nav class="toc" aria-label="Table of contents">
          <strong>Contents</strong>
          {tocHeadings.map((heading) => (
            <a class:list={[heading.depth === 3 && "toc-sub"]} href={`#${heading.slug}`}>{heading.text}</a>
          ))}
        </nav>
      )}
      <div class="article-content">
        <Content />
      </div>
    </article>

    <aside class="author-card" aria-label="About the author">
      <img src="/img/portrait-480.webp" alt="" width="64" height="80" loading="lazy" />
      <div>
        <p class="author-name">Haitao Zheng</p>
        <p>
          Cyber Security &amp; Privacy student at H-BRS. I write about the
          security tools I build and the fixes I contribute upstream.
        </p>
        <p class="author-links">
          <a href="/about/">About</a>
          <a href="/contributions/">Open-source work</a>
          <a href="https://github.com/0xTaoZ">GitHub ↗</a>
          {article.filePath && <a href={`https://github.com/0xTaoZ/tzheng.dev/blob/main/${article.filePath}`}>Source of this page ↗</a>}
          <a href="/rss.xml">RSS</a>
        </p>
      </div>
    </aside>

    <nav class="article-pager" aria-label="More articles">
      {previous && (
        <a class="card compact" href={`/articles/${entrySlug(previous)}/`} rel="prev">
          <span class="meta">← Previous</span>
          <h3>{previous.data.title}</h3>
        </a>
      )}
      {next && (
        <a class="card compact pager-next" href={`/articles/${entrySlug(next)}/`} rel="next">
          <span class="meta">Next →</span>
          <h3>{next.data.title}</h3>
        </a>
      )}
    </nav>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <h2 id="related-heading">Related articles</h2>
        <div class="related-grid">
          {related.map((rel) => (
            <a class="card compact" href={`/articles/${entrySlug(rel)}/`}>
              <h3>{rel.data.title}</h3>
              <span class="meta">{rel.data.category}, {readingTime(rel)}</span>
              <p>{rel.data.excerpt}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
  <script>
    import "../../scripts/article.js";
  </script>
</BaseLayout>
