---
import "../styles/home.css";
import "../styles/home-utilities.css";
import { getCollection } from "astro:content";
import { entrySlug, selectHomepageProjects } from "../lib/content";
import SiteHead from "../components/SiteHead.astro";
import {
  mergedCount,
  repositoryCount,
  upstreamRepositories,
  verifiedAt,
} from "../lib/contributions";
import HomeNavigation from "../components/home/Navigation.astro";
import HomeHero from "../components/home/Hero.astro";
import HomeContributions from "../components/home/Contributions.astro";
import HomeProjects from "../components/home/Projects.astro";
import HomeSystemGateway from "../components/home/SystemGateway.astro";
import HomeArticles from "../components/home/Articles.astro";
import HomeEducation from "../components/home/Education.astro";
import HomeToolkit from "../components/home/Toolkit.astro";
import HomeAbout from "../components/home/About.astro";
import HomeFooter from "../components/home/Footer.astro";
import HomeContact from "../components/home/Contact.astro";
const projects = selectHomepageProjects(await getCollection("projects"));
const terminalLines = [
  "$ whoami",
  "haitao.zheng / tao",
  "",
  "$ focus --area",
  "cloud-security / blue-team / systems",
  "",
  "$ builds --selected",
  ...projects.map(
    (project, index) =>
      `${String(index + 1).padStart(2, "0")}  ${entrySlug(project)}`,
  ),
  "",
  "$ upstream --merged",
  `${mergedCount} PRs / ${repositoryCount} projects / ${verifiedAt}`,
];
const leading = [...upstreamRepositories]
  .sort((a, b) => b.stars - a.stars)
  .slice(0, 4)
  .map((repository) => repository.label);
const description = `Haitao Zheng (Tao) studies Cyber Security & Privacy at H-BRS in Germany: ${mergedCount} merged open-source PRs to ${leading.join(", ")} and more, security tools and technical notes.`;
const profileSchema = {
  "@type": "ProfilePage",
  "@id": "https://tzheng.dev/#profile",
  url: "https://tzheng.dev/",
  name: "Haitao Zheng",
  mainEntity: { "@id": "https://tzheng.dev/#person" },
  dateModified: `${verifiedAt}T00:00:00Z`,
};
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Haitao Zheng (郑海涛) | Cyber Security & Open Source"
      description={description}
      ogType="profile"
      structuredData={profileSchema}
    />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <meta name="yandex-verification" content="0dfbab3f3b38610b" />
    <meta name="msvalidate.01" content="CC8AED0FA93BE482A324F0EC51216889" />
  </head>
  <body class="antialiased selection:bg-blue-600 selection:text-white">
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <HomeNavigation />
    <main id="main-content" tabindex="-1">
      <HomeHero terminalLines={terminalLines} />

      <HomeContributions />

      <div class="divider max-w-6xl mx-auto"></div>

      <!-- 精选项目-->
      <HomeProjects />

      <div class="divider max-w-6xl mx-auto"></div>

      <!-- Technical writing and archive -->
      <HomeArticles />

      <div class="divider max-w-6xl mx-auto"></div>
      <!-- System Design gateway -->
      <HomeSystemGateway />

      <div class="divider max-w-6xl mx-auto"></div>
      <!-- 教育经历  -->
      <HomeEducation />

      <div class="divider max-w-6xl mx-auto"></div>

      <!-- 技术栈 (Technical Toolkit Section) -->
      <HomeToolkit />

      <div class="divider max-w-6xl mx-auto"></div>
      <!-- 语言与兴趣 (Languages & Interests) -->
      <HomeAbout />

      <div class="divider max-w-6xl mx-auto"></div>
      <HomeContact />
    </main>
    <HomeFooter />
    <script>
      import "../scripts/home.js";
    </script>
  </body>
</html>
