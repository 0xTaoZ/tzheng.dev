                    '$ focus --area',
                    'cloud-security / blue-team / systems',
                    '',
                    '$ build --featured',
                    '01  cloudtrail-quickscan',
                    '02  Sentinel-IOC-Toolkit',
                    '03  cfn-lint contribution',
                    '04  tzheng.dev',
                    '',
                    '$ principles',
                    'static-first / minimal surface / reviewable code'
