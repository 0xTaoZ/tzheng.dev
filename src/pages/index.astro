    }
    requestAnimationFrame(() => {
        b.classList.remove('opacity-0', 'translate-y-1');
        b.classList.add('opacity-100', 'translate-y-0');
    });
    setTimeout(() => {
        b.classList.remove('opacity-100', 'translate-y-0');
