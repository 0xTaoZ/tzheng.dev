---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { entrySlug } from "../lib/content";
import {
  mergedCount,
  repositoryCount,
  contributionCases,
  verifiedAt,
} from "../lib/contributions";
const projects = (await getCollection("projects", ({ data }) => data.featured))
  .sort((a, b) => a.data.priority - b.data.priority)
  .slice(0, 3);
const articles = (
  await getCollection("articles", ({ data }) => data.status === "published")
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Haitao Zheng — Security tooling & cloud infrastructure">
  <div class="shell">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-topline">
        <span class="kicker">
          An engineering portfolio / <span lang="zh">郑海涛</span>
        </span>
        <span class="location">
          <span class="status-dot"></span>Based in Germany
        </span>
      </div>
      <div class="hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title">
            Haitao<span>Zheng.</span>
          </h1>
          <p class="hero-role">
            Security tools &<br />
            cloud infrastructure.
          </p>
          <p class="hero-description">
            I study Cyber Security & Privacy at H-BRS, build tools for
            investigation, and contribute fixes to the open-source systems
            engineers depend on.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="/projects/">
              Explore the work <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="/contributions/">
              See the contributions <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <figure class="portrait">
          <img
            src="/portrait.webp"
            srcset="/portrait-small.webp 480w, /portrait.webp 800w"
            sizes="(max-width:560px) calc(100vw - 40px), (max-width:800px) 40vw, 375px"
            alt="Portrait of Haitao Zheng"
            width="800"
            height="1000"
            fetchpriority="high"
          />
          <span class="portrait-tag">
            Student by title.
            <br />
            Contributor by practice.
          </span>
          <figcaption>
            <span>Haitao Zheng / Tao</span>
            <span>Security & systems</span>
          </figcaption>
        </figure>
      </div>
      <div class="proof-strip">
        <p>Work accepted in projects beyond my own repositories.</p>
        <div class="proof-item">
          <strong>{mergedCount}</strong>
          <span>Merged upstream PRs</span>
        </div>
        <div class="proof-item">
          <strong>{repositoryCount}</strong>
          <span>Upstream projects</span>
        </div>
        <div class="proof-item">
          <strong style="font-size:30px">H-BRS</strong>
          <span>B.Sc. Cyber Security & Privacy</span>
        </div>
      </div>
      <p class="note">
        GitHub snapshot · {verifiedAt} · Includes code, tests and documentation.{" "}
        <a href="/contributions/#record">Inspect the record ↗</a>
      </p>
    </section>
    <section class="section" id="contributions">
      <div class="section-heading">
        <span class="section-number">01 / Beyond my own code</span>
        <div class="section-title-row">
          <div>
            <h2>
              Small patches.
              <br />
              Real boundaries.
            </h2>
            <p>
              Selected merged work where correctness matters: authentication,
              deployment validation and security evidence.
            </p>
          </div>
          <a class="text-link" href="/contributions/">
            The full record <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="contribution-list">
        {contributionCases.map((item) => (
          <article class="contribution-row">
            <div>
              <span class="meta">{item.area}</span>
              <h3>{item.repository}</h3>
              <span class="merge-label">Merged · #{item.number}</span>
            </div>
            <div>
              <h3>{item.title}</h3>
              <p style="margin-top:12px">{item.lesson}</p>
            </div>
            <a
              class="text-link"
              href={item.url}
              aria-label={`Read merged ${item.repository} pull request ${item.number}`}
            >
              <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </section>
    <section class="section" id="projects">
      <div class="section-heading">
        <span class="section-number">02 / Selected builds</span>
        <div class="section-title-row">
          <div>
            <h2>Built to be useful.</h2>
            <p>
              A working product, a cloud-log scanner and a data inspection tool.
              Each solves a different problem.
            </p>
          </div>
          <a class="text-link" href="/projects/">
            All projects <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="work-list">
        {projects.map((project, index) => (
          <ProjectRow project={project} index={index} />
        ))}
      </div>
    </section>
    <section class="section" id="notes">
      <div class="section-heading">
        <span class="section-number">03 / Field notes</span>
        <div class="section-title-row">
          <div>
            <h2>
              The reasoning
              <br />
              behind the work.
            </h2>
            <p>Decisions, failure modes and lessons from the code.</p>
          </div>
          <a class="text-link" href="/articles/">
            All writing <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="writing-list">
        {articles.map((article) => (
          <a class="writing-row" href={`/articles/${entrySlug(article)}/`}>
            <time datetime={article.data.date.toISOString()}>
              {article.data.date.toLocaleDateString("en-GB", {
                month: "short",
                year: "numeric",
                timeZone: "UTC",
              })}
            </time>
            <div>
              <h3>{article.data.title}</h3>
              <p>{article.data.excerpt}</p>
            </div>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
    <section class="section" id="about">
      <div class="about-summary">
        <div>
          <span class="eyebrow">04 / The person</span>
          <h2>
            Curious about
            <br />
            the whole system.
          </h2>
        </div>
        <div>
          <p>
            My work sits between security and infrastructure: understanding what
            a system actually does, finding where its assumptions break, and
            making the result easier to inspect.
          </p>
          <p>
            Outside the code, I photograph people and places with a Nikon D750,
            cycle and train. Different ways to pay attention.
          </p>
          <a class="text-link" href="/about/">
            More about me <span aria-hidden="true">↗</span>
          </a>
        </div>
        <dl class="about-facts">
          <div id="education">
            <dt>Currently</dt>
            <dd>
              B.Sc. Cyber Security & Privacy
              <br />
              Hochschule Bonn-Rhein-Sieg
            </dd>
          </div>
          <div id="toolkit">
            <dt>Working languages</dt>
            <dd>
              Python · TypeScript · Java
              <br />
              Linux · SQL · Git
            </dd>
          </div>
          <div>
            <dt>Spoken languages</dt>
            <dd>
              English · German · Mandarin
              <br />
              Hokkien · Japanese (basic)
            </dd>
          </div>
        </dl>
      </div>
    </section>
  </div>
</BaseLayout>
