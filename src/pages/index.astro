---
import { readFileSync } from "node:fs";
import { join } from "node:path";

const sourcePath = join(process.cwd(), "index.html");
const divider = '<div class="divider max-w-6xl mx-auto"></div>';

const takeBlock = (input: string, start: string, end: string) => {
  const startIndex = input.indexOf(start);
  const endIndex = input.indexOf(end, startIndex);
  if (startIndex === -1 || endIndex === -1) return { html: input, block: "" };
  return {
    html: input.slice(0, startIndex) + input.slice(endIndex),
    block: input.slice(startIndex, endIndex).trim()
  };
};

const systemEntry = `
<!-- System Design gateway -->
<section id="system-entry" class="py-28 px-6 max-w-7xl mx-auto">
    <div class="pro-card reveal p-8 md:p-12 overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-10 items-center">
            <div>
                <p class="section-kicker mb-4">Behind this site</p>
                <h2 class="text-4xl md:text-6xl font-bold text-white mb-5 tracking-tight">System Design.</h2>
                <p class="text-lg text-gray-300 leading-relaxed font-light max-w-3xl">A deep look at how this portfolio is engineered: static-first architecture, MDX content, Cloudflare Pages deployment, privacy-conscious defaults, and a maintainable publishing workflow.</p>
                <div class="flex flex-wrap gap-3 mt-7">
                    <span class="chip">Astro</span>
                    <span class="chip">MDX</span>
                    <span class="chip">Git workflow</span>
                    <span class="chip">Cloudflare Pages</span>
                    <span class="chip">Static-first security</span>
                </div>
                <a href="/system/" class="case-link mt-8">Read the architecture <span>↗</span></a>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div class="case-fact"><b>Content</b><span>Articles and project case studies are managed through structured files instead of hard-coded page data.</span></div>
                <div class="case-fact"><b>Deploy</b><span>GitHub commits trigger Cloudflare Pages builds, publishing the generated static site from dist.</span></div>
                <div class="case-fact"><b>Security</b><span>No public login surface, no unnecessary database, and a smaller attack surface by default.</span></div>
                <div class="case-fact"><b>Growth</b><span>The system can add RSS, search, Open Graph previews, and a Git-based CMS without changing the public model.</span></div>
            </div>
        </div>
    </div>
</section>`;

let html = readFileSync(sourcePath, "utf8")
  .replace(/<link rel="icon"[^>]+>/, '<link rel="icon" href="/favicon.png" type="image/png">\n    <link rel="apple-touch-icon" href="/apple-touch-icon.png">')
