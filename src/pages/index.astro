---
import { readFileSync } from "node:fs";
import { join } from "node:path";

const sourcePath = join(process.cwd(), "index.html");
const html = readFileSync(sourcePath, "utf8")
  .replace(/<link rel="icon"[^>]+>/, '<link rel="icon" href="/favicon.png" type="image/png">\n    <link rel="apple-touch-icon" href="/apple-touch-icon.png">')
  .replaceAll("./articles.html", "/articles/")
  .replaceAll("./legal.html", "/legal/")
  .replaceAll("./IMG_1419.jpg", "/IMG_1419.jpg")
  .replaceAll("hbrs-logo.png", "/hbrs-logo.png")
  .replaceAll("fhm-logo.png", "/fhm-logo.png")
  .replaceAll("harvard-logo.png", "/harvard-logo.png")
  .replaceAll("jimei-logo.png", "/jimei-logo.png")
  .replace(
    '<a href="#about" class="hover:text-white transition duration-300">About</a>',
    '<a href="/system/" class="hover:text-white transition duration-300">System Design</a>\n            <a href="#about" class="hover:text-white transition duration-300">About</a>'
  )
  .replace(
    '<a href="#about">About <span>↘</span></a>',
    '<a href="/system/">System Design <span>↗</span></a>\n    <a href="#about">About <span>↘</span></a>'
  )
  .replace(
    '<a href="mailto:h@tzheng.dev"><span>Contact by email</span><span>↗</span></a>',
    '<a href="/system/"><span>System Design</span><span>↗</span></a>\n                <a href="mailto:h@tzheng.dev"><span>Contact by email</span><span>↗</span></a>'
  )
  .replace(
    '<a href="/legal/" class="hover:text-white transition">Legal</a>',
    '<a href="/legal/" class="hover:text-white transition">Legal</a>\n                <a href="/system/" class="hover:text-white transition">System Design</a>'
  );
---

<Fragment set:html={html} />
