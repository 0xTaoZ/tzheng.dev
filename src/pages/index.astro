  )
  .replace(
    `const delay = isMobile() ? (text[i - 2] === '\\n' ? 56 : 12) : (text[i - 2] === '\\n' ? 34 : 7);`,
    `const delay = isMobile() ? (text[i - 2] === '\\n' ? 42 : 9) : (text[i - 2] === '\\n' ? 16 : 3);`
