---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { entrySlug } from "../../lib/content";
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.priority - b.data.priority,
);
---

<BaseLayout
  title="Work — Haitao Zheng"
  description="Security tools, a full-stack learning product and accepted upstream engineering. Project decisions, source code and limits."
>
  <div class="shell page-content">
    <header class="page-header">
      <span class="eyebrow">Work / projects & case studies</span>
      <h1>
        Useful problems.
        <br />
        Inspectable work.
      </h1>
      <p>
        Some projects are small on purpose. Others need a full application.
        These notes explain the problem, the engineering choices and the limits.
      </p>
    </header>
    <div class="index-list">
      {projects.map((project, index) => (
        <article class="work-row" id={entrySlug(project)}>
          <span class="section-number">
            {String(index + 1).padStart(2, "0")}
          </span>
          <div class="work-info">
            <span class="meta">{project.data.type}</span>
            <h3 style="margin-top:12px">
              <a href={`/projects/${entrySlug(project)}/`}>
                {project.data.title}
              </a>
            </h3>
            <div class="work-stack">
              {project.data.stack.map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </div>
          <p>{project.data.excerpt}</p>
          <a class="text-link" href={`/projects/${entrySlug(project)}/`}>
            Case study <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
    <p class="note">
      Tools are presented at their actual scope. Repository links include the
      code, examples and verification commands.
    </p>
  </div>
</BaseLayout>
