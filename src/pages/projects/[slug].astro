---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { entrySlug } from "../../lib/content";
export async function getStaticPaths() {
  return (await getCollection("projects")).map((project) => ({
    params: { slug: entrySlug(project) },
    props: { project },
  }));
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
const url = new URL(`/projects/${entrySlug(project)}/`, Astro.site).toString();
const schema = {
  "@type": "CreativeWork",
  name: project.data.title,
  description: project.data.excerpt,
  url,
  creator: { "@id": "https://tzheng.dev/#person" },
  sameAs: project.data.github,
};
---

<BaseLayout
  title={`${project.data.title} — Work by Haitao Zheng`}
  description={project.data.excerpt}
  structuredData={schema}
>
  <article class="article-body">
    <a class="text-link" href="/projects/">
      ← All work
    </a>
    <h1>{project.data.title}</h1>
    <div class="meta">
      <span>{project.data.type}</span>
      <span>{project.data.stack.join(" / ")}</span>
    </div>
    <p class="lead">{project.data.excerpt}</p>
    {project.data.outcome && <p>{project.data.outcome}</p>}
    <div class="actions">
      {project.data.github && (
        <a class="button primary" href={project.data.github}>
          Inspect the source <span aria-hidden="true">↗</span>
        </a>
      )}
      {project.data.demo && (
        <a class="button" href={project.data.demo}>
          Visit project ↗
        </a>
      )}
    </div>
    {headings.length > 0 && (
      <nav class="toc" aria-label="On this page">
        <strong>On this page</strong>
        {headings
          .filter((h) => h.depth === 2)
          .map((h) => (
            <a href={`#${h.slug}`}>{h.text}</a>
          ))}
      </nav>
    )}
    <Content />
    <div class="article-pager">
      <a href="/projects/">
        <span>Continue exploring</span>All projects ←
      </a>
      <a href="/contributions/">
        <span>Accepted upstream work</span>Open-source record →
      </a>
    </div>
  </article>
</BaseLayout>
