---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { entrySlug, byPublication, readingTime } from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: entrySlug(project) },
    props: { project },
  }));
}

const { project } = Astro.props;
const notes = (
  await getCollection(
    "articles",
    ({ data }) => data.status === "published" && data.project === entrySlug(project),
  )
).sort(byPublication);
const { Content, headings } = await render(project);
const projectUrl = new URL(
  `/projects/${entrySlug(project)}/`,
  Astro.site,
).toString();
const projectKeywords = [project.data.type, ...project.data.stack];
const projectSchema = {
  "@type": "SoftwareSourceCode",
  "@id": `${projectUrl}#project`,
  name: project.data.title,
  description: project.data.excerpt,
  url: projectUrl,
  dateCreated: project.data.date.toISOString(),
  creator: { "@id": "https://tzheng.dev/#person" },
  publisher: { "@id": "https://tzheng.dev/#website" },
  keywords: projectKeywords,
  codeRepository: project.data.github,
  programmingLanguage: project.data.stack,
  applicationCategory: project.data.type,
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${projectUrl}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://tzheng.dev/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Projects",
      item: "https://tzheng.dev/projects/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: project.data.title,
      item: projectUrl,
    },
  ],
};
---

<BaseLayout
  title={`${project.data.title} | Projects`}
  description={project.data.excerpt}
  keywords={projectKeywords}
  ogImage={`/og/projects/${entrySlug(project)}.png`}
  ogImageAlt={project.data.title}
  structuredData={[projectSchema, breadcrumbSchema]}
>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <main id="main-content" tabindex="-1" class="article-body">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/projects/">Projects</a>
      <span aria-hidden="true">/</span>
      <span>{project.data.type}</span>
    </nav>
    <header class="article-header">
      <h1 class="carried" style={`view-transition-name: p-${entrySlug(project)}`}>{project.data.title}</h1>
      <p class="article-lede">{project.data.excerpt}</p>
      {project.data.homepageFacts.length > 0 && (
        <dl class="project-facts">
          {project.data.homepageFacts.map((fact) => (
            <div><dt>{fact.label}</dt><dd>{fact.text}</dd></div>
          ))}
        </dl>
      )}
      <div class="meta">
        <span>{project.data.type}</span>
        <span>{project.data.status}</span>
        <span>Case study updated {project.data.date.toLocaleDateString("en", { month: "long", year: "numeric", timeZone: "UTC" })}</span>
      </div>
      <div class="meta tag-row">
        {project.data.stack.map((item) => <span class="chip">{item}</span>)}
      </div>
      {project.data.outcome && <p class="note">{project.data.outcome}</p>}
      <div class="actions">
        {project.data.github && (
          <a class="button primary" href={project.data.github}>
            {project.data.github.includes("/pull/") ? "Read the merged PR ↗" : "Source on GitHub ↗"}
          </a>
        )}
        {project.data.demo && <a class="button" href={project.data.demo}>Demo ↗</a>}
      </div>
    </header>
    {headings.filter((heading) => heading.depth <= 3).length > 1 && (
      <nav class="toc" aria-label="Table of contents">
        <strong>Contents</strong>
        {headings.filter((heading) => heading.depth <= 3).map((heading) => (
          <a class:list={[heading.depth === 3 && "toc-sub"]} href={`#${heading.slug}`}>{heading.text}</a>
        ))}
      </nav>
    )}
    <div class="article-content">
    <Content />
    </div>
    {notes.length > 0 && (
      <section class="related" aria-labelledby="project-notes">
        <h2 id="project-notes">Notes about this project</h2>
        <div class="related-grid">
          {notes.map((note) => (
            <a class="card compact" href={`/articles/${entrySlug(note)}/`}>
              <h3>{note.data.title}</h3>
              <span class="meta">{note.data.category}, {readingTime(note)}</span>
              <p>{note.data.excerpt}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
  <script>
    import "../../scripts/article.js";
  </script>
</BaseLayout>
