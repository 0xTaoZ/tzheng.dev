---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Haitao Zheng"
  description="This page could not be found. Explore projects, writing or the homepage."
>
  <main id="main-content" tabindex="-1" class="article-body">
    <header class="page-header">
      <h1>Page not found</h1>
      <p>
        The link may have moved, or the address may be incomplete. Use the links
        below to continue.
      </p>
      <div class="actions">
        <a class="button primary" href="/">
          Back to home ↗
        </a>
        <a class="button" href="/projects/">
          Explore projects
        </a>
        <a class="button" href="/articles/">
          Read the notes
        </a>
      </div>
      <form class="article-filters" role="search" action="/articles/" method="get">
        <label>Search the articles<input type="search" name="q" placeholder="CloudTrail, SSH, Prowler…" /></label>
        <button class="button" type="submit">Search</button>
      </form>
    </header>
  </main>
</BaseLayout>
