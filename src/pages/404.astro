---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found — Haitao Zheng"
  description="This page could not be found. Explore projects, writing or the homepage."
>
  <div class="shell page-content">
    <header class="page-header">
      <span class="eyebrow">404 / No page here</span>
      <h1>A wrong turn.</h1>
      <p>
        The link may have moved, or the address may be incomplete. The work is
        still here.
      </p>
      <div class="actions">
        <a class="button primary" href="/">
          Back to home ↗
        </a>
        <a class="button" href="/projects/">
          Explore projects
        </a>
        <a class="button" href="/articles/">
          Read the notes
        </a>
      </div>
    </header>
  </div>
</BaseLayout>
