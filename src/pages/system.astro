---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="System Design | tzheng.dev" description="How tzheng.dev evolved from a custom cyber portfolio into a versioned, content-driven static engineering system.">
  
  <!-- Cursor glow elements (same as index.html) -->
  <div id="sys-cursor-field" class="sys-cursor-field" aria-hidden="true"></div>
  <div id="sys-cursor-dot" class="sys-cursor-dot" aria-hidden="true"></div>
  <!-- Ambient particle canvas -->
  <canvas id="sys-ambient" class="sys-ambient-canvas" aria-hidden="true"></canvas>

  <header class="sys-hero shell">
    <div class="hero-grid">
      <div class="hero-narrative">
        <span class="eyebrow">BEHIND THIS SITE</span>
        <h1 class="sys-title">System Design.</h1>
        <p class="sys-subtitle">How tzheng.dev evolved from a custom cyber portfolio into a versioned, content-driven static engineering system.</p>
        <div class="narrative-text">
          <p>This is not a list of technologies.</p>
          <p>It is the story of how the site was designed, how its architecture changed, how content moves from source files to production, what broke during the migration, and why some forms of complexity were deliberately left out.</p>
        </div>
      </div>
      <aside class="hero-profile">
        <div class="sys-card profile-card" data-tilt>
          <div class="sys-card-inner">
            <h3 class="profile-heading">SYSTEM PROFILE</h3>
            <div class="profile-grid">
              <div class="profile-fact"><b>RUNTIME MODEL</b><span>Static</span></div>
              <div class="profile-fact"><b>FRAMEWORK</b><span>Astro 5</span></div>
              <div class="profile-fact"><b>CONTENT</b><span>MDX Collections</span></div>
              <div class="profile-fact"><b>BUILD</b><span>Node 24</span></div>
              <div class="profile-fact"><b>SOURCE OF TRUTH</b><span>Git</span></div>
              <div class="profile-fact"><b>DELIVERY</b><span>GitHub Pages &rarr; Cloudflare Edge</span></div>
            </div>
          </div>
        </div>
      </aside>
    </div>
    <div class="hero-tags">
      <span class="chip">Astro 5</span>
      <span class="chip">TypeScript</span>
      <span class="chip">MDX</span>
      <span class="chip">Git</span>
      <span class="chip">CI/CD</span>
      <span class="chip">Static Delivery</span>
    </div>
  </header>

  <!-- Mobile Chapter Bar -->
  <nav class="chapter-bar sys-lg-hidden sys-glass-bar" aria-label="Chapters Mobile">
    <ul class="chapter-list-mobile">
      <li><a href="#origin" class="ch-link">01 Origin</a></li>
      <li><a href="#architecture" class="ch-link">02 Arch</a></li>
      <li><a href="#content" class="ch-link">03 Content</a></li>
      <li><a href="#delivery" class="ch-link">04 Delivery</a></li>
      <li><a href="#interface" class="ch-link">05 Interface</a></li>
      <li><a href="#problems" class="ch-link">06 Problems</a></li>
      <li><a href="#security" class="ch-link">07 Security</a></li>
    </ul>
  </nav>

  <div class="sys-body shell">
    <!-- Desktop Story Rail -->
    <aside class="rail-wrapper">
      <nav class="story-rail" aria-label="Chapters Desktop">
        <div class="rail-label">THE STORY RAIL</div>
        <div class="rail-track">
          <ul class="rail-list">
            <li><a href="#origin" class="ch-link" aria-current="page">Origin</a></li>
            <li><a href="#architecture" class="ch-link">Architecture</a></li>
            <li><a href="#content" class="ch-link">Content</a></li>
            <li><a href="#delivery" class="ch-link">Delivery</a></li>
            <li><a href="#interface" class="ch-link">Interface</a></li>
            <li><a href="#problems" class="ch-link">Problems</a></li>
            <li><a href="#security" class="ch-link">Security</a></li>
          </ul>
        </div>
      </nav>
    </aside>

    <main class="story-main">
      
      <!-- 01 ORIGIN -->
      <section id="origin" class="chapter reveal">
        <h2 class="ch-kicker">01 &mdash; From Interface to System</h2>
        <h3 class="ch-heading">The interface could grow. The content model could not.</h3>
        <p>tzheng.dev began as a highly customized personal homepage.</p>
        <p>The original architecture was built around visual identity: custom HTML, CSS, JavaScript, motion, terminal-inspired interactions, project presentations, and a deliberately cinematic first impression.</p>

        <div class="callout-block">Keep the expressive interface. Rebuild the system underneath it.</div>
        
        <p>The homepage remained the identity layer.</p>
        <p>Articles and projects became structured content.</p>
        <p>Astro became responsible for routing, content generation, metadata, and production builds.</p>

        <div class="sys-card reveal" data-tilt>
          <div class="sys-card-inner ba-grid">
            <div class="ba-col">
              <div class="ba-label">BEFORE</div>
              <ul>
                <li>Custom homepage</li>
                <li>Hardcoded content</li>
                <li>Direct page edits</li>
                <li>Presentation owns structure</li>
              </ul>
            </div>
            <div class="ba-arrow">&rarr;</div>
            <div class="ba-col ba-after">
              <div class="ba-label ba-label-accent">AFTER</div>
              <ul>
                <li>Identity layer</li>
                <li>Structured content</li>
                <li>Generated routes</li>
                <li>Astro build system</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- 02 ARCHITECTURE -->
      <section id="architecture" class="chapter reveal">
        <h2 class="ch-kicker">02 &mdash; The Architecture</h2>
        <h3 class="ch-heading">Static by design, not by limitation.</h3>
        
        <div class="sys-card reveal" data-tilt>
          <div class="sys-card-inner">
            <p class="arch-intro"><strong>Astro owns the structural layer of the site:</strong></p>
            <div class="chip-row">
              <span class="chip">routing</span>
              <span class="chip">content collections</span>
              <span class="chip">metadata</span>
              <span class="chip">sitemap generation</span>
            </div>
          </div>
        </div>

        <p>The system can be understood as a sequence of transformations:</p>

        <div class="sys-card reveal" data-tilt>
          <div class="sys-card-inner flow-row">
            <div class="flow-node">
              <h4>AUTHORING</h4>
              <span>Astro pages &middot; MDX content</span>
            </div>
            <div class="flow-sep">&rarr;</div>
            <div class="flow-node flow-highlight">
              <h4>SOURCE OF TRUTH</h4>
              <span>Git repository</span>
            </div>
            <div class="flow-sep">&rarr;</div>
            <div class="flow-node">
              <h4>BUILD</h4>
              <span>Astro build</span>
            </div>
            <div class="flow-sep">&rarr;</div>
            <div class="flow-node">
              <h4>OUTPUT</h4>
              <span>dist/</span>
            </div>
            <div class="flow-sep">&rarr;</div>
            <div class="flow-node">
              <h4>VISITOR</h4>
              <span>Cloudflare Edge</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 03 CONTENT -->
      <section id="content" class="chapter reveal">
        <h2 class="ch-kicker">03 &mdash; Content as a System</h2>
        <h3 class="ch-heading">A new article should be a content file, not homepage surgery.</h3>
        <p>Articles and projects are no longer treated as permanent fragments inside a large homepage. They live inside <code>src/content/</code> as structured collections, each governed by a Zod schema in <code>config.ts</code>.</p>

        <div class="schema-row">
          <div class="sys-card reveal" data-tilt>
            <div class="sys-card-inner">
              <h4 class="schema-title">ARTICLE SCHEMA</h4>
              <pre><code>title: string
slug: string
date: date
tags: array</code></pre>
            </div>
          </div>
          <div class="sys-card reveal" data-tilt>
            <div class="sys-card-inner">
              <h4 class="schema-title">PROJECT SCHEMA</h4>
              <pre><code>title: string
slug: string
status: string
stack: array</code></pre>
            </div>
          </div>
        </div>

        <div class="sys-card reveal" data-tilt>
          <div class="sys-card-inner pipeline">
            <div class="pipe-node">MDX FILE</div>
            <div class="pipe-sep">&darr;</div>
            <div class="pipe-node">SCHEMA VALIDATION</div>
            <div class="pipe-sep">&darr;</div>
            <div class="pipe-node pipe-accent">STATIC PAGE</div>
          </div>
        </div>
      </section>

      <!-- 04 DELIVERY -->
      <section id="delivery" class="chapter reveal">
        <h2 class="ch-kicker">04 &mdash; From Commit to Production</h2>
        <h3 class="ch-heading">One commit triggers one pipeline. One pipeline produces one artifact.</h3>
        <p>The deployment pipeline has no manual gates. A push to <code>main</code> triggers GitHub Actions, which runs <code>npm run build</code>, produces <code>dist/</code>, and deploys to GitHub Pages. Cloudflare sits in front as the edge cache.</p>

        <div class="sys-card reveal" data-tilt>
          <div class="sys-card-inner flow-row">
            <div class="flow-node">
              <h4>COMMIT</h4>
              <span>git push</span>
            </div>
            <div class="flow-sep">&rarr;</div>
            <div class="flow-node flow-highlight">
              <h4>GITHUB ACTIONS</h4>
              <span>npm run build</span>
            </div>
            <div class="flow-sep">&rarr;</div>
            <div class="flow-node">
              <h4>ARTIFACT</h4>
              <span>dist/</span>
            </div>
            <div class="flow-sep">&rarr;</div>
            <div class="flow-node">
              <h4>EDGE</h4>
              <span>Cloudflare</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 05 INTERFACE -->
      <section id="interface" class="chapter reveal">
        <h2 class="ch-kicker">05 &mdash; The Interface Layer</h2>
        <h3 class="ch-heading">Two layers, one page.</h3>
        <p>The homepage is a cinematic identity layer: motion, parallax, terminal typewriter, 3D card tilt. The content pages are a structured reading layer: clean typography, schema-driven metadata, predictable layout.</p>

        <div class="sys-card reveal" data-tilt>
          <div class="sys-card-inner layer-stack">
            <div class="layer-box layer-identity">
              <h4>IDENTITY LAYER</h4>
              <p>cinematic &middot; interactive &middot; motion-aware</p>
            </div>
            <div class="layer-sep">&updownarrow;</div>
            <div class="layer-box layer-content">
              <h4>CONTENT LAYER</h4>
              <p>structured &middot; readable &middot; predictable</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 06 PROBLEMS -->
      <section id="problems" class="chapter reveal">
        <h2 class="ch-kicker">06 &mdash; What Broke Along the Way</h2>
        <h3 class="ch-heading">Real migration logs, not hypothetical.</h3>

        <div class="challenge-stack">
          <div class="sys-card reveal" data-tilt>
            <div class="sys-card-inner">
              <h4 class="challenge-title">Challenge 01 &mdash; Migrating the Interface</h4>
              <div class="pdr-grid">
                <div class="pdr-label">PROBLEM</div>
                <div class="pdr-value">Changing content without destroying identity.</div>
                <div class="pdr-label pdr-decision">DECISION</div>
                <div class="pdr-value">Preserve the visual layer and rebuild the architecture around it.</div>
              </div>
            </div>
          </div>
          <div class="sys-card reveal" data-tilt>
            <div class="sys-card-inner">
              <h4 class="challenge-title">Challenge 02 &mdash; Deployment Boundaries</h4>
              <div class="pdr-grid">
                <div class="pdr-label">PROBLEM</div>
                <div class="pdr-value">Source is no longer the final output.</div>
                <div class="pdr-label pdr-decision">DECISION</div>
                <div class="pdr-value">Make <code>dist/</code> the explicit deployment artifact. Never deploy source directly.</div>
              </div>
            </div>
          </div>
          <div class="sys-card reveal" data-tilt>
            <div class="sys-card-inner">
              <h4 class="challenge-title">Challenge 03 &mdash; Build-time TypeScript</h4>
              <div class="pdr-grid">
                <div class="pdr-label">PROBLEM</div>
                <div class="pdr-value">Astro 5 enforces strict TypeScript checks at build time. Implicit <code>any</code> types and incorrect API usage break the build.</div>
                <div class="pdr-label pdr-decision">DECISION</div>
                <div class="pdr-value">Type every variable explicitly. Validate locally before pushing.</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 07 SECURITY -->
      <section id="security" class="chapter reveal">
        <h2 class="ch-kicker">07 &mdash; Security Through Less Surface</h2>
        <h3 class="ch-heading">The best defense is what doesn't exist.</h3>
        <p>A static site has no runtime server, no database, no admin panel, no session store. The attack surface is the CDN configuration and the client-side JavaScript.</p>

        <div class="trust-row">
          <div class="sys-card reveal" data-tilt>
            <div class="sys-card-inner">
              <h4 class="trust-title trust-exists">WHAT EXISTS</h4>
              <ul class="trust-list">
                <li>Git repository</li>
                <li>CI/CD pipeline</li>
                <li>Client JavaScript</li>
                <li>CDN edge cache</li>
              </ul>
            </div>
          </div>
          <div class="sys-card reveal" data-tilt>
            <div class="sys-card-inner">
              <h4 class="trust-title trust-absent">WHAT DOES NOT EXIST</h4>
              <ul class="trust-list">
                <li>No runtime database</li>
                <li>No admin login</li>
                <li>No server sessions</li>
                <li>No user-submitted data</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

    </main>
  </div>
</BaseLayout>

<style>
/* ===================================================================
   system.astro scoped styles
   Design system: mirrors index.html card, cursor, canvas, tilt logic
   =================================================================== */

/* --- Cursor glow (same CSS as index.html .cursor-field/.cursor-dot) --- */
.sys-cursor-field,
.sys-cursor-dot {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 120;
    pointer-events: none;
    border-radius: 999px;
    opacity: 0;
    transform: translate3d(-50%, -50%, 0);
    transition: opacity .25s ease;
}
.sys-cursor-field {
    width: 21rem;
    height: 21rem;
    background: radial-gradient(circle, rgba(125,211,252,.14), rgba(57,255,136,.055) 36%, transparent 68%);
    mix-blend-mode: screen;
    filter: blur(2px);
}
.sys-cursor-dot {
    width: .42rem;
    height: .42rem;
    background: rgba(186,230,253,.95);
    box-shadow: 0 0 18px rgba(125,211,252,.85);
}
body.sys-pointer-ready .sys-cursor-field,
body.sys-pointer-ready .sys-cursor-dot {
    opacity: 1;
}

/* --- Ambient Canvas --- */
.sys-ambient-canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.32;
    mix-blend-mode: screen;
    contain: strict;
    transform: translateZ(0);
}

/* --- Reveal animation (same as index.html) --- */
.reveal {
    opacity: 0;
    transform: translateY(60px) scale(0.95);
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1),
                transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
}
.reveal.active {
    opacity: 1;
    transform: translateY(0) scale(1);
}

/* --- Hero --- */
.sys-hero {
    padding-top: 5rem;
    padding-bottom: 3rem;
    position: relative;
    z-index: 2;
}
.hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
}
@media (min-width: 1024px) {
    .hero-grid {
        grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
        align-items: center;
        gap: 4rem;
    }
}
.sys-title {
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.96;
    letter-spacing: -0.065em;
    font-weight: 700;
    color: #fff;
    margin: 1rem 0;
}
.sys-subtitle {
    color: #dbeafe;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.6;
    font-weight: 300;
}
.narrative-text p {
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 1rem;
    font-size: 1.05rem;
    margin-top: 1.6rem;
}
.hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: 2.5rem;
}

/* --- Profile card specifics --- */
.profile-card { width: 100%; }
.profile-heading {
    font: 700 .72rem ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--muted);
    letter-spacing: .12em;
    margin: 0 0 1.2rem 0;
}
.profile-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: .9rem;
}
.profile-fact b {
    display: block;
    color: var(--muted);
    font: 500 .68rem ui-monospace, SFMono-Regular, Menlo, monospace;
    margin-bottom: .25rem;
}
.profile-fact span {
    color: #f8fafc;
    font-size: .88rem;
    font-weight: 500;
}

/* ===========================================================
   .sys-card — exact replication of index.html .project-case
   =========================================================== */
.sys-card {
    position: relative;
    overflow: hidden;
    border-radius: 1.35rem;
    border: 1px solid rgba(148,163,184,.16);
    background: linear-gradient(145deg, rgba(16,24,39,.72), rgba(2,6,14,.66));
    backdrop-filter: blur(22px) saturate(145%);
    -webkit-backdrop-filter: blur(22px) saturate(145%);
    transition: transform .65s cubic-bezier(.16,1,.3,1),
                border-color .45s ease,
                box-shadow .65s cubic-bezier(.16,1,.3,1),
                background .45s ease;
    transform-style: preserve-3d;
    will-change: transform;
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    --mx: 50%;
    --my: 0%;
}

/* Mouse-tracking radial glow (::before) — same as .project-case::before */
.sys-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at var(--mx) var(--my), rgba(125,211,252,.18), transparent 20rem);
    opacity: 0;
    transition: opacity .35s ease;
}

/* Inner sheen layer (::after) — same as .project-case::after */
.sys-card::after {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    pointer-events: none;
    background:
        linear-gradient(135deg, rgba(255,255,255,.08), transparent 28%, transparent 72%, rgba(125,211,252,.055)),
        radial-gradient(circle at var(--mx) var(--my), rgba(57,255,136,.075), transparent 16rem);
    opacity: .42;
    transition: opacity .45s ease;
}

.sys-card:hover {
    border-color: rgba(125,211,252,.30);
    box-shadow: 0 30px 90px rgba(0,0,0,.46), 0 0 0 1px rgba(125,211,252,.05) inset;
}
.sys-card:hover::before { opacity: 1; }
.sys-card:hover::after { opacity: .85; }

/* 3D tilt transform — same logic as index.html */
@media (pointer: fine) and (min-width: 1024px) {
    .sys-card,
    .sys-card:hover {
        transform: perspective(1000px)
            rotateX(var(--tilt-x))
            rotateY(var(--tilt-y))
            translateY(var(--lift, 0px))
            scale(var(--card-scale, 1));
    }
    .sys-card:hover {
        --lift: -4px;
    }
}

.sys-card-inner {
    position: relative;
    z-index: 1;
    padding: clamp(1.25rem, 3vw, 2.25rem);
}

/* --- Mobile Chapter Bar --- */
.sys-glass-bar {
    position: sticky;
    top: 58px;
    z-index: 40;
    background: rgba(2, 5, 10, 0.62);
    backdrop-filter: saturate(180%) blur(30px);
    -webkit-backdrop-filter: saturate(180%) blur(30px);
    border-bottom: 1px solid rgba(148, 163, 184, 0.13);
    padding: 0.75rem 1rem;
    overflow-x: auto;
    white-space: nowrap;
}
.sys-glass-bar::-webkit-scrollbar { display: none; }
.chapter-list-mobile {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1.5rem;
}
.chapter-list-mobile .ch-link {
    color: var(--muted);
    font: .8rem ui-monospace, SFMono-Regular, Menlo, monospace;
    padding: .3rem .6rem;
    border-radius: 6px;
    transition: all .3s ease;
}
.chapter-list-mobile .ch-link[aria-current="page"] {
    color: #fff;
    background: rgba(125,211,252,.15);
    box-shadow: 0 0 18px rgba(125,211,252,.35);
    border: 1px solid rgba(125,211,252,.25);
}

/* --- Two-column layout --- */
.sys-body {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    padding-top: 2rem;
    padding-bottom: 6rem;
    position: relative;
    z-index: 2;
}
.rail-wrapper { display: none; }
@media (min-width: 1024px) {
    .sys-body { flex-direction: row; }
    .sys-lg-hidden { display: none !important; }
    .rail-wrapper {
        display: block;
        width: 220px;
        flex-shrink: 0;
    }
    .story-rail {
        position: sticky;
        top: 120px;
        max-height: calc(100vh - 140px);
        overflow-y: auto;
    }
}
.rail-label {
    font: .7rem ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--blue);
    letter-spacing: .12em;
    margin-bottom: 1.5rem;
}
.rail-track {
    position: relative;
    border-left: 1px solid rgba(148,163,184,.16);
    padding-left: 1.25rem;
}
.rail-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
}
.rail-list .ch-link {
    display: block;
    color: var(--muted);
    font-size: .9rem;
    font-weight: 500;
    transition: color .3s ease, transform .3s ease, text-shadow .3s ease;
    position: relative;
}
.rail-list .ch-link:hover {
    color: #fff;
    transform: translateX(5px);
}
.rail-list .ch-link[aria-current="page"] {
    color: #fff;
    transform: translateX(8px);
    text-shadow: 0 0 15px rgba(125,211,252,.8);
}
.rail-list .ch-link::before {
    content: '';
    position: absolute;
    left: -1.25rem;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 0;
    background: var(--blue);
    border-radius: 4px;
    box-shadow: 0 0 15px var(--blue);
    transition: height .3s ease;
}
.rail-list .ch-link[aria-current="page"]::before {
    height: 20px;
}

/* --- Story content --- */
.story-main {
    flex: 1;
    max-width: 720px;
}
.chapter {
    margin-bottom: 8rem;
    scroll-margin-top: 140px;
}
.ch-kicker {
    font: .9rem ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--blue);
    letter-spacing: .05em;
    margin: 0 0 1.2rem 0;
}
.ch-heading {
    font-size: 1.8rem;
    font-weight: 600;
    color: #fff;
    line-height: 1.3;
    margin: 0 0 2rem 0;
}
.chapter p {
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
    font-size: 1.05rem;
    font-weight: 300;
}
.chapter code {
    color: var(--green);
    background: rgba(57,255,136,.08);
